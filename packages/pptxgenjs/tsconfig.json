{
	"compilerOptions": {
		"allowSyntheticDefaultImports": true,
		"declaration": false,
		"declarationDir": null,
		"lib": [
			"dom",
			"es2020"
		],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"noImplicitAny": false,
		"outDir": "./dist",
		"sourceMap": true,
		"strict": true,
		"strictNullChecks": false, // NOTE: very necessary!
		"target": "ES2020",
	},
	"display": "Recommended",
	"$schema": "https://json.schemastore.org/tsconfig",
	"include": [
		"src/**/*"
	]
}
