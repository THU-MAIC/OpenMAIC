/** Discover provider modules and emit static imports plus client-safe metadata. */
import { readdir, writeFile } from 'node:fs/promises';
import { fileURLToPath, pathToFileURL } from 'node:url';
import path from 'node:path';
import type { WebFetchProvider } from '../lib/web-fetch/types';

const root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..');
const directory = path.join(root, 'lib/web-fetch/providers');
const names = (await readdir(directory)).filter((name) => name.endsWith('.ts')).sort();
const providers: WebFetchProvider[] = [];
for (const name of names) {
  const providerModule = await import(pathToFileURL(path.join(directory, name)).href);
  const provider = providerModule.default as WebFetchProvider;
  if (!provider?.id || typeof provider.extract !== 'function') {
    throw new Error(`Invalid web fetch provider module: ${name}`);
  }
  if (providers.some((entry) => entry.id === provider.id)) {
    throw new Error(`Duplicate web fetch provider id: ${provider.id}`);
  }
  providers.push(provider);
}
const header = '// Generated by scripts/generate-web-fetch-registry.mts. Do not edit.\n';
await writeFile(
  path.join(root, 'lib/web-fetch/providers.generated.ts'),
  header +
    names
      .map((name, index) => `import provider${index} from './providers/${name.slice(0, -3)}';\n`)
      .join('') +
    `\nexport const providers = [${names.map((_, index) => `provider${index}`).join(', ')}];\n`,
);
const metadata = Object.fromEntries(
  providers.map(({ id, name, icon, hosted, requiresApiKey, defaultBaseUrl, credentialPreset }) => [
    id,
    {
      id,
      name,
      ...(icon ? { icon } : {}),
      hosted,
      requiresApiKey,
      ...(defaultBaseUrl ? { defaultBaseUrl } : {}),
      ...(credentialPreset ? { credentialPreset } : {}),
    },
  ]),
);
await writeFile(
  path.join(root, 'lib/web-fetch/metadata.generated.json'),
  JSON.stringify(metadata, null, 2) + '\n',
);
