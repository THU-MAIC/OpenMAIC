# Ollama Cloud example for OpenMAIC cyberphysical telemetry analysis.
# Copy to .env.local, then replace the API key.
#
# The /v1 suffix remains compatible with OpenMAIC's existing OpenAI-compatible
# Ollama provider. The cyberphysical adapter maps it to https://ollama.com/api/chat.
OLLAMA_BASE_URL=https://ollama.com/v1
OLLAMA_API_KEY=replace-with-your-ollama-cloud-api-key
OLLAMA_MODEL=gpt-oss:120b
OLLAMA_MODELS=gpt-oss:120b
