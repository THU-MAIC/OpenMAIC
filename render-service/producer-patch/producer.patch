+
+  // One bounded guardian protocol; exit, pipe EOF, ACK and cancellation share state.
+  // fallow-ignore-next-line complexity
+  async function launch(
+    domain: string,
+    root: string,
+    candidate: string,
+    signal: AbortSignal,
+    deadline: number,
+  ) {
