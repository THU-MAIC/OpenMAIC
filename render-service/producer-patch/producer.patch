+      // sibling directory and its temporary objects belong to this task.
+      chownSync(root, options.workerUid, options.workerGid);
+      const scratch = join(root, "scratch");
+      mkdirSync(scratch, { mode: 0o700 });
+      chownSync(scratch, options.workerUid, options.workerGid);
