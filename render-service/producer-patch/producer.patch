+import { afterEach, describe, expect, it, vi } from "vitest";
+import { EventEmitter } from "node:events";
+import { PassThrough } from "node:stream";
+import {
+  mkdtempSync,
+  readFileSync,
+  readdirSync,
+  realpathSync,
+  rmSync,
+  writeFileSync,
+} from "node:fs";
+import { join } from "node:path";
+import { tmpdir } from "node:os";
+import { createRenderRequest } from "../renderRequest.js";
+import { ArtifactTransaction } from "../services/render/artifactTransaction.js";
+
+const boundary = vi.hoisted(() => ({
+  spawn: vi.fn(),
+  kill: vi.fn(),
+  remove: vi.fn(),
+  close: vi.fn(),
+  pressure: vi.fn<() => import("./linux.js").PressureObservation>(() => ({
+    ancestors: [],
+    triggers: [],
+  })),
+  accounting: vi.fn(),
+  cleanupFailure: false,
+  renderFailure: false,
+  publicationCleanupFailure: false,
+  guardianLost: false,
+  guardianHung: false,
+  guardianPipeHeld: false,
+}));
+vi.mock("node:child_process", async (original) => ({
+  ...(await original<typeof import("node:child_process")>()),
+  spawn: boundary.spawn,
+}));
+vi.mock("node:fs", async (original) => {
+  const fs = await original<typeof import("node:fs")>();
+  return {
+    ...fs,
+    chownSync: vi.fn(),
+    rmSync: (...args: Parameters<typeof fs.rmSync>) => {
+      if (
+        boundary.publicationCleanupFailure &&
+        typeof args[0] === "string" &&
+        args[0].split("/").at(-1)?.includes(".hf-transaction-")
+      )
+        throw new Error("injected directory cleanup failure");
+      return fs.rmSync(...args);
+    },
+  };
+});
+vi.mock("./linux.js", () => ({
+  runtimeFiles: () => ({ launcher: "/packaged/launcher", worker: "/packaged/worker" }),
+  LinuxTasks: class {
+    validateBudget() {}
+    pressure = boundary.pressure;
+    accounting = boundary.accounting;
+    deadlineAt(deadline: number) {
+      return deadline;
+    }
+    create() {
+      return "/delegated/task";
+    }
+    kill = boundary.kill;
+    reaped() {
+      return true;
+    }
+    remove = boundary.remove;
+    close = boundary.close;
+  },
+}));
+import { createBudgetedProducer } from "./supervisor.js";
+
+const directories: string[] = [];
+afterEach(() => {
+  vi.restoreAllMocks();
+  boundary.cleanupFailure = false;
+  boundary.renderFailure = false;
+  boundary.publicationCleanupFailure = false;
+  boundary.guardianLost = false;
+  boundary.guardianHung = false;
+  boundary.guardianPipeHeld = false;
+  boundary.spawn.mockReset();
+  boundary.kill.mockReset();
+  boundary.remove.mockReset();
+  boundary.pressure.mockReset().mockReturnValue({ ancestors: [], triggers: [] });
+  for (const dir of directories.splice(0)) rmSync(dir, { recursive: true, force: true });
+});
+
+function setup() {
+  // This suite verifies S's actual owner/transaction code using synthetic
+  // protocol receipts; it deliberately does not claim Linux mechanism proof.
+  const dir = realpathSync(
+    mkdtempSync(join(process.platform === "linux" ? "/var/tmp" : tmpdir(), "hf-resource-owner-")),
+  );
+  directories.push(dir);
+  const output = join(dir, "render.mp4");
+  writeFileSync(output, "previous");
+  const request = createRenderRequest({
+    projectDir: dir,
+    outputPath: output,
+    options: { fps: { num: 1, den: 1 }, quality: "draft", format: "mp4" },
+  });
+  boundary.remove.mockReturnValue({
+    memoryCurrent: "4096",
+    memoryEvents: "oom 0",
+    memoryEventsLocal: "oom 0",
+    cpuStat: "usage_usec 1234",
+  });
+  boundary.accounting.mockImplementation(() => boundary.remove.getMockImplementation()?.());
+  boundary.spawn.mockImplementation((_file: string, args: string[]) => {
+    const root = args[1];
+    const candidate = args[2];
+    if (!root || !candidate) throw new Error("Missing owned paths");
+    const child = new EventEmitter();
+    const stdin = new PassThrough(),
+      stdout = new PassThrough(),
+      stderr = new PassThrough();
+    let prepared = false;
+    const finish = () => {
+      for (const name of readdirSync(root)) {
+        if (name !== candidate) rmSync(join(root, name), { recursive: true, force: true });
+      }
+      stdout.write(
+        JSON.stringify({ event: "drained", prepared, workerStatus: prepared ? 0 : 256 }) + "\n",
+      );
+      child.emit("close", 0);
+    };
+    stdin.on("data", (chunk: Buffer) => {
+      if (chunk.toString() === "G")
+        queueMicrotask(() => {
+          if (boundary.guardianHung) return;
+          if (boundary.guardianPipeHeld) {
+            child.emit("exit", null, "SIGKILL");
+            return;
+          }
+          if (boundary.guardianLost) {
+            child.emit("close", 125);
+            return;
+          }
+          if (boundary.renderFailure) {
+            stderr.write("concrete browser failure: socket closed");
+            child.emit("message", {
+              event: "failed",
+              cleanupFailed: false,
+              message: "render failed",
+            });
+            finish();
+          } else if (boundary.cleanupFailure) {
+            child.emit("message", {
+              event: "failed",
+              cleanupFailed: true,
+              message: "browser close failed",
+            });
+            finish();
+          } else {
+            const workerRequest = JSON.parse(readFileSync(join(root, "request.json"), "utf8"));
+            expect(workerRequest.outputPath).toBe(join(root, candidate));
+            expect(workerRequest.projectDir).toBe(dir);
+            writeFileSync(workerRequest.outputPath, "new render");
+            child.emit("message", { event: "prepared" });
+          }
+        });
+      if (chunk.toString() === "P") prepared = true;
+    });
+    return Object.assign(child, {
+      stdin,
+      stdout,
+      stderr,
+      kill: vi.fn(),
+      send(message: unknown, callback: (error?: Error) => void) {
+        expect(message).toEqual({ event: "prepared-ack" });
+        expect(prepared).toBe(true);
+        callback();
+        queueMicrotask(finish);
+      },
+    });
+  });
+  const budget = { cpuMillis: 500, memoryBytes: 128 * 1024 * 1024 };
+  const producer = createBudgetedProducer({
+    ...budget,
+    taskCgroupRoot: "/delegated",
+    maxActive: 1,
+    maxQueued: 1,
+    workerUid: 65534,
+    workerGid: 65534,
+    cleanupTimeoutMs: 100,
+  });
+  return { producer, request, budget, output, dir };
+}
+
+describe("budgeted Producer terminal ownership", () => {
+  it("rejects queued work when an ancestor reports local pressure before releasing a permit", async () => {
+    const { producer, request, budget } = setup();
+    boundary.guardianHung = true;
+    const active = expect(producer.render(request, budget, { timeoutMs: 1000 })).rejects.toThrow();
+    await vi.waitFor(() => expect(boundary.spawn).toHaveBeenCalledTimes(1));
+    const waiting = expect(producer.render(request, budget, { timeoutMs: 5000 })).rejects.toThrow(
+      "Ancestor memory pressure",
+    );
+    await vi.waitFor(() => expect(producer.status().queued).toBe(1));
+    boundary.pressure.mockReturnValue({
+      ancestors: [],
+      triggers: [{ path: "/delegated", event: "oom", before: "0", after: "1" }],
+    });
+    await waiting;
+    expect(producer.status()).toMatchObject({ closed: true, queued: 0 });
+    expect(boundary.spawn).toHaveBeenCalledTimes(1);
+    await active;
+    await expect(producer.close()).rejects.toThrow("quarantined");
+  });
+  it("preserves failed task accounting and returns the reservation once", async () => {
+    const { producer, request, budget } = setup();
+    boundary.renderFailure = true;
+    let failure: unknown;
+    try {
+      await producer.render(request, budget, { timeoutMs: 1000 });
+    } catch (error) {
+      failure = error;
+    }
+    expect(failure).toMatchObject({
+      cause: expect.any(Error),
+      settlement: {
+        published: false,
+        cleanupVerified: true,
+        reservationReturned: true,
+        residual: {
+          memoryCurrent: "4096",
+          memoryEvents: "oom 0",
+          memoryEventsLocal: "oom 0",
+          cpuStat: "usage_usec 1234",
+        },
+      },
+    });
+    expect(boundary.remove).toHaveBeenCalledTimes(1);
+    expect(producer.status()).toMatchObject({ active: 0, cpuMillis: 0, memoryBytes: 0 });
+    await producer.close();
+  });
+
+  it("stops queued admission on pressure observation failure without abandoning active cleanup", async () => {
+    const { producer, request, budget } = setup();
+    boundary.guardianHung = true;
+    const active = expect(producer.render(request, budget, { timeoutMs: 200 })).rejects.toThrow();
+    await vi.waitFor(() => expect(boundary.spawn).toHaveBeenCalledTimes(1));
+    const queued = expect(producer.render(request, budget, { timeoutMs: 5000 })).rejects.toThrow(
+      "ancestor pressure",
+    );
+    await vi.waitFor(() => expect(producer.status().queued).toBe(1));
+    boundary.pressure.mockImplementation(() => {
+      throw new Error("local event unavailable");
+    });
+    await queued;
+    expect(boundary.spawn).toHaveBeenCalledTimes(1);
+    expect(producer.status()).toMatchObject({
+      closed: true,
+      pressureFailure: expect.stringContaining("local event unavailable"),
+    });
+    await active;
+    await expect(producer.close()).rejects.toThrow("quarantined");
+  });
+
+  it("returns a rejected promise for invalid public render input", async () => {
+    const { producer, request, budget } = setup();
+    await expect(producer.render(request, budget, { timeoutMs: 0 })).rejects.toThrow("timeoutMs");
+    expect(boundary.spawn).not.toHaveBeenCalled();
+    await producer.close();
+  });
+  it("preserves renderer diagnostics alongside its failure receipt after a verified drain", async () => {
+    const { producer, request, budget, output } = setup();
+    boundary.renderFailure = true;
+    await expect(producer.render(request, budget, { timeoutMs: 1000 })).rejects.toThrow(
+      "render failed\nconcrete browser failure: socket closed",
+    );
+    expect(readFileSync(output, "utf8")).toBe("previous");
+    expect(producer.status()).toMatchObject({ active: 0, memoryBytes: 0, quarantined: 0 });
+    expect(boundary.remove).toHaveBeenCalledWith("/delegated/task");
+    await producer.close();
+  });
+
+  it("returns a cancelled permit before any payload can start", async () => {
+    const { producer, request, budget } = setup();
+    const cancel = new AbortController();
+    const work = producer.render(request, budget, { timeoutMs: 1000, signal: cancel.signal });
+    cancel.abort(new Error("cancelled permit"));
+    await expect(work).rejects.toThrow("cancelled permit");
+    expect(boundary.spawn).not.toHaveBeenCalled();
+    expect(producer.status()).toMatchObject({ active: 0, quarantined: 0 });
+    await producer.close();
+  });
+
+  it("takes fallback drain ownership when G exits without a receipt", async () => {
+    const { producer, request, budget, output } = setup();
+    boundary.guardianLost = true;
+    await expect(producer.render(request, budget, { timeoutMs: 1000 })).rejects.toThrow(
+      "quarantined",
