+import { describe, it } from "vitest";
+import { runInstalledCases } from "./installed-linux-cases.mjs";
+
+// One implementation of these cases; the guest invokes the same module with Node.
+const enabled =
+  process.platform === "linux" &&
+  process.getuid?.() === 0 &&
+  process.env.HYPERFRAMES_RESOURCE_TEST_CGROUP &&
+  process.env.HYPERFRAMES_RESOURCE_TEST_PACKAGE &&
+  process.env.HYPERFRAMES_RESOURCE_TEST_WORKDIR &&
+  process.env.HYPERFRAMES_RESOURCE_TEST_EVIDENCE;
+describe.skipIf(!enabled)("installed budgeted Producer on Linux", () => {
+  it("loads the packaged native and starts and drains a normal task", async () => {
+    await runInstalledCases("native-smoke");
+  }, 180000);
+  it("validates the packaged native boundary", async () => {
+    await runInstalledCases("native");
+  }, 180000);
+  it("exports twice through the real pipeline and returns its reservation", async () => {
+    await runInstalledCases("pipeline-normal");
+  }, 600000);
+  it("validates the real pipeline and its lifecycle", async () => {
+    await runInstalledCases("pipeline");
+  }, 600000);
+});
