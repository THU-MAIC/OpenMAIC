index 000000000..59c3757d6
--- /dev/null
+++ b/packages/producer/native/resource-launcher.c
@@ -0,0 +1,336 @@
+#define _GNU_SOURCE
+#include <dirent.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <grp.h>
+#include <limits.h>
+#include <linux/capability.h>
+#include <linux/sched.h>
+#include <math.h>
+#include <poll.h>
+#include <sched.h>
+#include <signal.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/mount.h>
+#include <sys/prctl.h>
+#include <sys/stat.h>
+#include <sys/syscall.h>
+#include <sys/types.h>
+#include <sys/wait.h>
+#include <time.h>
+#include <unistd.h>
+
+/* One task, one lifeline. This executable is not a daemon or a general shell.
+ * stdin belongs only to S; fd 3 is Node's IPC channel, inherited only by W.
+ * G stays outside A and reaps all W descendants before its terminal receipt.
+ */
+static int domain = -1;
+static volatile sig_atomic_t stopping;
+static const char *root, *candidate;
+
+static double monotonic(void) {
+  struct timespec t;
+  if (clock_gettime(CLOCK_MONOTONIC, &t)) _exit(125);
+  return t.tv_sec + t.tv_nsec / 1e9;
+}
+
+static void fail(const char *operation) {
+  int saved = errno;
+  fprintf(stderr, "resource-launcher: %s: errno=%d (%s)\n", operation, saved, strerror(saved));
+  _exit(125);
+}
+
+static void stop(int signal) { (void)signal; stopping = 1; }
+
+static void put(const char *name, const char *value) {
+  int fd = openat(domain, name, O_WRONLY | O_CLOEXEC | O_NOFOLLOW);
+  if (fd < 0) fail(name);
+  if (write(fd, value, strlen(value)) != (ssize_t)strlen(value)) fail(name);
+  if (close(fd)) fail("close cgroup control");
+}
+
+static int populated(void) {
+  char text[256];
+  int fd = openat(domain, "cgroup.events", O_RDONLY | O_CLOEXEC | O_NOFOLLOW);
+  if (fd < 0) fail("cgroup.events");
+  ssize_t n = read(fd, text, sizeof(text) - 1);
+  close(fd);
+  if (n <= 0) fail("read cgroup.events");
+  text[n] = 0;
+  char *p = strstr(text, "populated ");
+  if (!p || (p[10] != '0' && p[10] != '1')) fail("parse cgroup.events");
+  return p[10] == '1';
+}
+
+static unsigned long number(const char *text) {
+  char *end;
+  errno = 0;
+  unsigned long n = strtoul(text, &end, 10);
+  if (errno || !*text || *end || n > INT_MAX) fail("numeric argument");
+  return n;
+}
+
+static void close_from(unsigned fd) {
+  if (syscall(SYS_close_range, fd, ~0U, 0)) fail("close_range");
+}
+
+static void drop(uid_t uid, gid_t gid) {
+  for (int cap = 0; cap < 64; cap++) {
+    if (prctl(PR_CAPBSET_DROP, cap, 0, 0, 0) && errno != EINVAL) fail("capability bounding set");
+  }
+  if (setgroups(0, NULL) || setresgid(gid, gid, gid) || setresuid(uid, uid, uid)) fail("worker identity");
+  struct __user_cap_header_struct h = { _LINUX_CAPABILITY_VERSION_3, 0 };
+  struct __user_cap_data_struct data[2] = {{0}, {0}};
+  if (syscall(SYS_capset, &h, data) || prctl(PR_SET_NO_NEW_PRIVS, 1, 0, 0, 0)) fail("worker capabilities");
+}
+
+static void check_management_denied(int original_mount, const char *cgroup) {
+  const char *prefix = "/sys/fs/cgroup/";
+  if (strncmp(cgroup, prefix, strlen(prefix))) { errno = EINVAL; fail("cgroup location"); }
+  char ancestor[PATH_MAX];
+  if (snprintf(ancestor, sizeof(ancestor), "%s", cgroup + strlen(prefix)) >= (int)sizeof(ancestor)) fail("cgroup location length");
+  const char *names[] = { "cgroup.procs", "cgroup.subtree_control", "cgroup.kill", "cpu.max", "memory.max" };
+  for (;;) {
+    for (size_t i = 0; i < sizeof(names) / sizeof(names[0]); i++) {
+      char path[PATH_MAX];
+      if (snprintf(path, sizeof(path), "%s%s%s", ancestor, *ancestor ? "/" : "", names[i]) >= (int)sizeof(path)) fail("management check path");
+      int fd = openat(original_mount, path, O_WRONLY | O_CLOEXEC | O_NOFOLLOW);
+      if (fd >= 0) { close(fd); errno = EPERM; fail("worker can manage its cgroup hierarchy"); }
+      if (errno != EACCES && errno != EPERM && errno != EROFS && errno != ENOENT) fail("management permission evidence");
+    }
+    if (!*ancestor) break;
+    char *slash = strrchr(ancestor, '/');
+    if (slash) *slash = 0; else *ancestor = 0;
+  }
+}
+
+/* Delete only this reserved directory, never follow a worker-created symlink.
+ * Executed in A, so recursive cleanup shares the task's hard resource limits.
+ */
+static void clean_directory(int fd, const char *keep, unsigned depth) {
+  if (depth > 128) { errno = ELOOP; fail("cleanup depth"); }
+  DIR *dir = fdopendir(dup(fd));
+  if (!dir) fail("cleanup directory");
+  struct dirent *entry;
+  errno = 0;
+  while ((entry = readdir(dir))) {
+    const char *name = entry->d_name;
+    if (!strcmp(name, ".") || !strcmp(name, "..") || (keep && !strcmp(name, keep))) continue;
+    struct stat st;
+    if (fstatat(fd, name, &st, AT_SYMLINK_NOFOLLOW)) fail("cleanup stat");
+    if (!S_ISDIR(st.st_mode) && st.st_nlink > 1) { errno = EMLINK; fail("unknown retained file reference"); }
+    if (S_ISDIR(st.st_mode)) {
+      int child = openat(fd, name, O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC);
+      if (child < 0) fail("cleanup open");
+      clean_directory(child, NULL, depth + 1);
+      close(child);
+      if (unlinkat(fd, name, AT_REMOVEDIR)) fail("cleanup rmdir");
+    } else if (unlinkat(fd, name, 0)) fail("cleanup unlink");
+    errno = 0;
+  }
+  if (errno) fail("cleanup readdir");
+  closedir(dir);
+}
+
+static pid_t clone_child(int *pidfd, int into_task) {
+  struct clone_args args = {0};
+  args.flags = CLONE_PIDFD | (into_task ? CLONE_INTO_CGROUP : 0);
+  args.cgroup = into_task ? (uint64_t)domain : 0;
+  args.pidfd = (uint64_t)(uintptr_t)pidfd;
+  args.exit_signal = SIGCHLD;
+  pid_t pid = (pid_t)syscall(SYS_clone3, &args, sizeof(args));
+  if (pid < 0) fail(into_task ? "clone3(CLONE_INTO_CGROUP)" : "clone3(cleanup bootstrap)");
+  return pid;
+}
+
+static int reap(pid_t leader, int *leader_status) {
+  int status;
+  pid_t pid;
+  while ((pid = waitpid(-1, &status, WNOHANG)) > 0) {
+    if (pid == leader) *leader_status = status;
+  }
+  if (pid < 0 && errno != ECHILD && errno != EINTR) fail("waitpid");
+  return pid < 0 && errno == ECHILD;
+}
+
+static void drain(pid_t leader, int *status, double deadline) {
+  /* The launch permit is already revoked; no business process can be created
+   * after this point. cgroup.kill covers descendants that detached sessions. */
+  put("cgroup.kill", "1");
+  for (;;) {
+    int empty = reap(leader, status);
+    int populated_now = populated();
+    if (monotonic() >= deadline) { errno = ETIMEDOUT; fail("drain deadline"); }
+    if (empty && !populated_now) return;
+    poll(NULL, 0, 10);
+  }
+}
+
+int main(int argc, char **argv) {
+  if (argc != 10) return 64;
+  /* cgroup, reserved artifact directory, candidate basename, uid, gid,
+   * CLOCK_MONOTONIC deadline ms, cleanup timeout ms, Node executable, worker entry. */
+  root = argv[2]; candidate = argv[3];
+  uid_t uid = (uid_t)number(argv[4]);
+  gid_t gid = (gid_t)number(argv[5]);
+  char *end;
+  errno = 0;
+  double deadline = strtod(argv[6], &end) / 1000.0;
+  if (errno || !*argv[6] || *end || !isfinite(deadline) || deadline <= 0) return 64;
+  double cleanup = number(argv[7]) / 1000.0;
+  if (!uid || !gid || cleanup <= 0 || strchr(candidate, '/') || !strcmp(candidate, ".") || !strcmp(candidate, "..")) return 64;
+  struct stat reserved_directory;
+  if (root[0] != '/' || lstat(root, &reserved_directory) || !S_ISDIR(reserved_directory.st_mode) ||
+      reserved_directory.st_uid != uid || reserved_directory.st_gid != gid ||
+      (reserved_directory.st_mode & 0777) != 0700) {
+    errno = EPERM; fail("reserved directory identity");
+  }
+  signal(SIGPIPE, SIG_IGN);
+  struct sigaction action = { .sa_handler = stop };
+  sigemptyset(&action.sa_mask);
+  if (sigaction(SIGTERM, &action, NULL) || sigaction(SIGINT, &action, NULL)) fail("signal handler");
+  if (prctl(PR_SET_CHILD_SUBREAPER, 1, 0, 0, 0) || prctl(PR_SET_DUMPABLE, 0, 0, 0, 0)) fail("guardian identity");
+  domain = open(argv[1], O_RDONLY | O_DIRECTORY | O_CLOEXEC | O_NOFOLLOW);
+  if (domain < 0 || populated()) fail("task domain");
+  int flags = fcntl(0, F_GETFL);
+  if (flags < 0 || fcntl(0, F_SETFL, flags | O_NONBLOCK)) fail("lifeline");
+  int granted = 0, preserve = 0, parent_alive = 1, worker_status = -1, worker_fd = -1;
+  pid_t worker = -1;
+  for (;;) {
+    if (stopping || monotonic() >= deadline) break;
+    struct pollfd life = { .fd = 0, .events = POLLIN | POLLHUP };
+    if (poll(&life, 1, 10) < 0 && errno != EINTR) fail("lifeline poll");
+    /* HUP wins even when a buffered start/prepare command is readable. */
+    if (life.revents & (POLLHUP | POLLERR | POLLNVAL)) { parent_alive = 0; break; }
+    if (stopping || monotonic() >= deadline) break;
+    if (life.revents & POLLIN) {
+      char command;
+      ssize_t n = read(0, &command, 1);
+      if (n == 0) { parent_alive = 0; break; }
+      if (n < 0 && errno != EAGAIN && errno != EINTR) fail("lifeline read");
+      if (n == 1) {
+        if (command == 'C') break;
+        if (command == 'P' && worker > 0) preserve = 1;
+        else if (command == 'G' && !granted) {
+          granted = 1;
+          worker = clone_child(&worker_fd, 1);
+          if (worker == 0) {
+            /* Initialization, Node imports and media descendants begin in A.
+             * Only the task's cgroup view needs a private mount namespace. */
+            int management = open("/sys/fs/cgroup", O_PATH | O_DIRECTORY | O_CLOEXEC);
+            if (management < 0) fail("management permission view");
+            if (unshare(CLONE_NEWNS | CLONE_NEWCGROUP)) fail("task cgroup view");
+            if (mount(NULL, "/", NULL, MS_REC | MS_PRIVATE, NULL)) fail("private mounts");
+            char scratch[PATH_MAX], request[PATH_MAX];
+            if (snprintf(scratch, sizeof(scratch), "%s/scratch", root) >= (int)sizeof(scratch) ||
+                snprintf(request, sizeof(request), "%s/request.json", root) >= (int)sizeof(request)) fail("task paths");
+            /* Existing Engine memory heuristics read the cgroup mount root.
+             * Expose A read-only there; do not add a second memory estimator. */
+            if (mount(argv[1], "/sys/fs/cgroup", NULL, MS_BIND, NULL) ||
+                mount(NULL, "/sys/fs/cgroup", NULL, MS_BIND | MS_REMOUNT | MS_RDONLY | MS_NOSUID | MS_NODEV | MS_NOEXEC, NULL)) fail("read-only task cgroup view");
+            /* Chrome's Unix socket paths must fit sockaddr_un even when the
+             * output path is long. Keep one O_PATH handle to the same owned
+             * scratch directory in W; descendants use W's short procfs alias.
+             * It creates no filesystem alias or second cleanup owner, and
+             * preserves cwd and all original input/output paths. */
+            int scratch_fd = open(scratch, O_PATH | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC);
+            struct stat scratch_stat;
+            if (scratch_fd < 0 || fstat(scratch_fd, &scratch_stat) ||
+                scratch_stat.st_uid != uid || scratch_stat.st_gid != gid ||
+                (scratch_stat.st_mode & 0777) != 0700) fail("scratch identity");
+            char short_temp[64];
+            if (snprintf(short_temp, sizeof(short_temp), "/proc/%ld/fd/4", (long)getpid()) >= (int)sizeof(short_temp)) fail("scratch alias length");
+            if (setenv("TMPDIR", short_temp, 1) || setenv("PUPPETEER_TMP_DIR", short_temp, 1) || setenv("HOME", scratch, 1) || setenv("NODE_CHANNEL_FD", "3", 1) || setenv("NODE_CHANNEL_SERIALIZATION_MODE", "json", 1)) fail("worker environment");
+            int null = open("/dev/null", O_RDONLY);
+            if (null < 0 || dup2(null, 0) < 0 || dup2(2, 1) < 0) fail("worker streams");
+            drop(uid, gid);
+            // Check actual post-drop DAC/ACL permissions through the original
+            // mount, then discard it before any Node or composition code runs.
+            check_management_denied(management, argv[1]);
+            // fd 3 is IPC, fd 4 is only the task scratch handle. All management
+            // descriptors are discarded before Node starts; exec retains fd 4.
+            if (dup2(scratch_fd, 4) < 0 || fcntl(4, F_SETFD, 0)) fail("scratch descriptor");
+            close_from(5);
+            execl(argv[8], argv[8], argv[9], request, (char *)NULL);
+            fail("worker exec");
+          }
+          close(3); /* only W retains the payload IPC channel */
+          printf("{\"event\":\"started\",\"pid\":%ld}\n", (long)worker);
+          fflush(stdout);
+        } else { errno = EPROTO; fail("lifeline command"); }
+      }
+    }
+    if (stopping || monotonic() >= deadline) break;
+    if (worker > 0) {
+      reap(worker, &worker_status);
+      if (worker_status >= 0) break;
+    }
+  }
+  /* No more GO commands are consumed, including during cleanup. */
+  double clean_deadline = monotonic() + cleanup;
+  drain(worker, &worker_status, clean_deadline);
+  if (worker_fd >= 0) close(worker_fd);
+  preserve = preserve && parent_alive && !stopping && worker_status == 0 && monotonic() < deadline;
+  int reaper_fd = -1;
+  /* Some kernels compare the parent's kill_seq with the destination's and
+   * SIGKILL CLONE_INTO_CGROUP children after cgroup.kill (Linux 8e3599202166).
+   * Only this trusted cleanup bootstrap starts with G. It must enter and
+   * verify A before opening any task file or allocating a directory walker.
+   * Business W still uses atomic CLONE_INTO_CGROUP before all initialization.
+   */
+  pid_t cleaner = clone_child(&reaper_fd, 0);
+  if (cleaner == 0) {
+    put("cgroup.procs", "0");
+    char expected[32], actual[64];
+    int length = snprintf(expected, sizeof(expected), "%ld\n", (long)getpid());
+    int membership = openat(domain, "cgroup.procs", O_RDONLY | O_CLOEXEC | O_NOFOLLOW);
+    if (membership < 0) fail("cleanup membership");
+    ssize_t count = read(membership, actual, sizeof(actual));
+    close(membership);
+    if (length <= 0 || length >= (int)sizeof(expected) || count != length ||
+        memcmp(actual, expected, (size_t)length)) {
+      errno = EXDEV; fail("cleanup outside task domain");
+    }
+    printf("{\"event\":\"cleanup-entered\",\"pid\":%ld}\n", (long)getpid());
+    fflush(stdout);
+    close_from(3);
+    int fd = open(root, O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC);
+    if (fd < 0) fail("reserved artifact directory");
+    struct stat current;
+    if (fstat(fd, &current) || current.st_dev != reserved_directory.st_dev ||
+        current.st_ino != reserved_directory.st_ino) {
+      errno = ESTALE; fail("cleanup directory identity changed");
+    }
+    clean_directory(fd, preserve ? candidate : NULL, 0);
+    close(fd);
+    _exit(0);
+  }
+  int cleaner_status = -1;
+  for (;;) {
+    int empty = reap(cleaner, &cleaner_status);
+    int populated_now = populated();
+    if (monotonic() >= clean_deadline) {
+      put("cgroup.kill", "1");
+      errno = ETIMEDOUT; fail("cleanup deadline");
+    }
+    if (empty && !populated_now) break;
+    poll(NULL, 0, 10);
+  }
+  close(reaper_fd);
+  if (cleaner_status != 0) {
+    fprintf(stderr, "resource-launcher: cleanup status: worker=%d cleaner=%d exited=%d exit=%d signaled=%d signal=%d\n",
+            worker_status, cleaner_status,
+            cleaner_status >= 0 && WIFEXITED(cleaner_status),
+            cleaner_status >= 0 && WIFEXITED(cleaner_status) ? WEXITSTATUS(cleaner_status) : -1,
+            cleaner_status >= 0 && WIFSIGNALED(cleaner_status),
+            cleaner_status >= 0 && WIFSIGNALED(cleaner_status) ? WTERMSIG(cleaner_status) : -1);
+    errno = EIO; fail("cleanup child");
+  }
+  if (!parent_alive && rmdir(root)) fail("orphan directory cleanup");
+  printf("{\"event\":\"drained\",\"workerStatus\":%d,\"prepared\":%s}\n", worker_status, preserve ? "true" : "false");
+  fflush(stdout);
+  return 0;
+}
diff --git a/packages/producer/native/resource-supervisor.c b/packages/producer/native/resource-supervisor.c
new file mode 100644
index 000000000..dad24a4ae
--- /dev/null
+++ b/packages/producer/native/resource-supervisor.c
@@ -0,0 +1,109 @@
+#define _GNU_SOURCE
+#include <node_api.h>
+#include <dirent.h>
+#include <errno.h>
+#include <limits.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/prctl.h>
+#include <sys/wait.h>
+#include <time.h>
+#include <unistd.h>
+
+/* JS cannot set PR_SET_CHILD_SUBREAPER. Keep this binding limited to the S
+ * lifecycle requirement; never reap Node's ordinary children or G itself. */
+static napi_value error(napi_env env, const char *message) {
+  napi_throw_error(env, NULL, message);
+  return NULL;
+}
+
+static napi_value initialize(napi_env env, napi_callback_info info) {
+  (void)info;
+  /* Fail before changing process-wide state when descendant enumeration is
+   * unavailable. This entry is for a dedicated supervisor process only. */
+  if (access("/proc/thread-self/children", R_OK)) return error(env, "Supervisor requires readable proc children (CONFIG_PROC_CHILDREN)");
+  int enabled = 0;
+  if (prctl(PR_SET_CHILD_SUBREAPER, 1, 0, 0, 0) ||
+      prctl(PR_GET_CHILD_SUBREAPER, &enabled, 0, 0, 0) || !enabled ||
+      prctl(PR_SET_DUMPABLE, 0, 0, 0, 0)) return error(env, "Cannot establish supervisor lifecycle ownership");
+  napi_value result;
+  napi_get_undefined(env, &result);
+  return result;
+}
+
+static napi_value page_size(napi_env env, napi_callback_info info) {
+  (void)info;
+  long size = sysconf(_SC_PAGESIZE);
+  if (size <= 0) return error(env, "Cannot read Linux page size");
+  napi_value result;
+  napi_create_int64(env, size, &result);
+  return result;
+}
+
+static napi_value monotonic_milliseconds(napi_env env, napi_callback_info info) {
+  (void)info;
+  struct timespec clock;
+  if (clock_gettime(CLOCK_MONOTONIC, &clock)) return error(env, "Cannot read supervisor monotonic clock");
+  napi_value result;
+  napi_create_double(env, clock.tv_sec * 1000.0 + clock.tv_nsec / 1e6, &result);
+  return result;
+}
+
+static napi_value reap_task(napi_env env, napi_callback_info info) {
+  napi_value argv[1], result;
+  size_t argc = 1, length;
+  char expected[PATH_MAX];
+  if (napi_get_cb_info(env, info, &argc, argv, NULL, NULL) != napi_ok || argc != 1 ||
+      napi_get_value_string_utf8(env, argv[0], expected, sizeof(expected), &length) != napi_ok ||
+      length >= sizeof(expected) - 1 || expected[0] != '/') return error(env, "Expected a unified cgroup membership path");
+  /* A subreaper's adopted children are listed on the owning thread. Inspect
+   * every S thread, and wait only for a child still assigned to this task. */
+  DIR *threads = opendir("/proc/self/task");
+  if (!threads) return error(env, "Cannot enumerate supervisor children");
+  int pending = 0, failed = 0, readable = 0;
+  struct dirent *thread;
+  while ((thread = readdir(threads))) {
+    char *end;
+    long tid = strtol(thread->d_name, &end, 10);
+    if (*end || tid <= 0) continue;
+    char path[128];
+    snprintf(path, sizeof(path), "/proc/self/task/%ld/children", tid);
+    FILE *children = fopen(path, "r");
+    if (!children) { if (errno != ENOENT) failed = 1; continue; }
+    readable++;
+    long pid;
+    while (fscanf(children, "%ld", &pid) == 1) {
+      snprintf(path, sizeof(path), "/proc/%ld/cgroup", pid);
+      FILE *file = fopen(path, "r");
+      if (!file) { if (errno != ENOENT) failed = 1; continue; }
+      char membership[PATH_MAX + 8];
+      char *line = fgets(membership, sizeof(membership), file);
+      fclose(file);
+      if (!line) { failed = 1; continue; }
+      membership[strcspn(membership, "\n")] = 0;
+      if (strncmp(membership, "0::", 3) || strcmp(membership + 3, expected)) continue;
+      int status;
+      pid_t reaped = waitpid((pid_t)pid, &status, WNOHANG);
+      if (!reaped) pending = 1;
+      else if (reaped < 0 && errno != ECHILD && errno != ESRCH) failed = 1;
+    }
+    if (ferror(children)) failed = 1;
+    fclose(children);
+  }
+  closedir(threads);
+  if (failed || !readable) return error(env, "Cannot verify task descendant reaping");
+  napi_get_boolean(env, !pending, &result);
+  return result;
+}
+
+NAPI_MODULE_INIT() {
+  napi_property_descriptor methods[] = {
+    { "initialize", NULL, initialize, NULL, NULL, NULL, napi_default, NULL },
+    { "pageSize", NULL, page_size, NULL, NULL, NULL, napi_default, NULL },
+    { "reapTask", NULL, reap_task, NULL, NULL, NULL, napi_default, NULL },
+    { "monotonicMilliseconds", NULL, monotonic_milliseconds, NULL, NULL, NULL, napi_default, NULL },
+  };
+  napi_define_properties(env, exports, 4, methods);
+  return exports;
+}
