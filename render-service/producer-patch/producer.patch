+export class BudgetedRenderError extends Error {
+  constructor(
+    cause: unknown,
+    readonly settlement: TaskSettlement,
+  ) {
+    super(cause instanceof Error ? cause.message : String(cause), { cause });
+    this.name = "BudgetedRenderError";
+  }
+}
+
+export interface BudgetedProducer {
+  render(
+    request: RenderRequest,
+    budget: TaskBudget,
+    options: { timeoutMs: number; signal?: AbortSignal },
+  ): Promise<BudgetedRenderResult>;
+  status(): ReturnType<Admission["snapshot"]> & {
+    pressure?: PressureObservation;
+    pressureFailure?: string;
+  };
+  /** Cancels pending and active work; refuses to close a quarantined owner. */
+  close(): Promise<void>;
+}
+
+function boundedInteger(value: number, name: string): void {
+  if (!Number.isSafeInteger(value) || value <= 0 || value > 2_147_483_647)
+    throw new Error(`Invalid ${name}`);
+}
+
+function record(value: unknown): value is Record<string, unknown> {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+// Validate the complete supported request boundary before granting launch.
+// fallow-ignore-next-line complexity
+function requestSnapshot(request: RenderRequest): string {
+  if (
+    !isAbsolute(request.projectDir) ||
+    realpathSync(request.projectDir) !== request.projectDir ||
+    !isAbsolute(request.outputPath) ||
+    realpathSync(dirname(request.outputPath)) !== dirname(request.outputPath)
+  ) {
+    throw new Error("Supervised requests require canonical absolute project and output paths");
+  }
+  for (const path of [request.projectDir, request.outputPath]) {
+    if (path === "/sys/fs/cgroup" || path.startsWith("/sys/fs/cgroup/"))
+      throw new Error("Retained input/output cannot be inside the task cgroup view");
+  }
+  if (["scratch", "request.json"].includes(basename(request.outputPath))) {
+    throw new Error("Output basename conflicts with task control files");
+  }
+  if (
+    request.options.debug ||
+    request.options.distributed ||
+    request.options.format === "png-sequence"
+  ) {
+    throw new Error("Supervised requests require local file output without retained debug state");
+  }
+  const text = JSON.stringify(request);
+  if (Buffer.byteLength(text) > 1024 * 1024) throw new Error("Render request exceeds 1 MiB");
