+      pressure = linux.pressure();
+      if (pressure.triggers.length) pressureFailure = "Ancestor memory pressure";
+    } catch (error) {
+      pressureFailure = `Cannot verify ancestor pressure: ${String(error)}`;
+    }
+    if (pressureFailure) {
+      admission.close(new Error(`Producer admission is closed: ${pressureFailure}`));
