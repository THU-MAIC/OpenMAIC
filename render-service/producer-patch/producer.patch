+    child.once("close", (code, signal) => {
+      Object.assign(evidence, { closed: true, code, signal });
+      persist(evidence);
+      ok(code);
+    }),
+  );
+  return {
+    evidence,
+    done,
+    waitReady: (check, ms = 12000) =>
+      until(() => {
+        if (check()) return true;
+        if (evidence.exitObserved || evidence.spawnError || evidence.closed)
+          throw new Error(
+            `Launcher exited before readiness: code=${evidence.code} signal=${evidence.signal} ${evidence.spawnError ?? ""} ${evidence.stderr}`,
+          );
