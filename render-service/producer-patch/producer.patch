--- /dev/null
+++ b/packages/producer/src/resources/linux.ts
@@ -0,0 +1,295 @@
+import { createRequire } from "node:module";
+import {
+  accessSync,
+  constants,
+  lstatSync,
+  mkdirSync,
+  readFileSync,
+  readdirSync,
+  realpathSync,
+  rmdirSync,
+  writeFileSync,
+} from "node:fs";
+import { dirname, join, relative } from "node:path";
+import { fileURLToPath } from "node:url";
+import { randomUUID } from "node:crypto";
+import { performance } from "node:perf_hooks";
+import type { TaskBudget } from "./admission.js";
+
+interface NativeSupervisor {
+  initialize(): void;
+  pageSize(): number;
+  reapTask(membership: string): boolean;
+  monotonicMilliseconds(): number;
+}
+
+function nativeSupervisor(value: unknown): value is NativeSupervisor {
+  return (
+    typeof value === "object" &&
+    value !== null &&
+    ["initialize", "pageSize", "reapTask", "monotonicMilliseconds"].every(
+      (name) => typeof Reflect.get(value, name) === "function",
+    )
+  );
+}
+
+export interface TaskAccounting {
+  memoryCurrent: string;
+  memoryEvents: string;
+  memoryEventsLocal: string;
+  cpuStat: string;
+}
+
+export interface AncestorMemory {
+  path: string;
+  memoryCurrent: string;
+  memoryHigh: string;
+  memoryMax: string;
+  memoryEventsLocal: string;
+}
+
+export interface PressureObservation {
+  ancestors: AncestorMemory[];
+  triggers: { path: string; event: string; before: string; after: string }[];
+}
+
+function localCounter(text: string, key: string): bigint {
+  const match = new RegExp(`^${key} (\\d+)$`, "m").exec(text);
+  if (!match?.[1]) throw new Error(`Missing local memory event ${key}`);
+  return BigInt(match[1]);
+}
+
+export function memoryPressure(
+  previous: AncestorMemory[],
+  current: AncestorMemory[],
+): PressureObservation {
+  if (previous.length !== current.length) throw new Error("Ancestor pressure identity changed");
+  const triggers: PressureObservation["triggers"] = [];
+  current.forEach((row, index) => {
+    const before = previous[index];
+    if (!before || before.path !== row.path) throw new Error("Ancestor pressure identity changed");
+    // Hierarchical events include task OOMs. Only local limit/reclaim failures
+    // identify pressure at this ancestor; oom_kill describes victims instead.
+    for (const key of ["high", "max", "oom"]) {
+      const a = localCounter(before.memoryEventsLocal, key);
+      const b = localCounter(row.memoryEventsLocal, key);
+      if (b < a) throw new Error("Ancestor memory counter reset");
+      if (b > a) triggers.push({ path: row.path, event: key, before: String(a), after: String(b) });
+    }
+    if (row.memoryHigh !== "max" && BigInt(row.memoryCurrent) >= BigInt(row.memoryHigh)) {
+      triggers.push({
+        path: row.path,
+        event: "at-memory.high",
+        before: row.memoryHigh,
+        after: row.memoryCurrent,
+      });
+    }
+  });
+  return { ancestors: current, triggers };
+}
+
+export function runtimeFiles() {
+  const moduleDirectory = dirname(fileURLToPath(import.meta.url));
+  const dist = import.meta.url.endsWith(".ts")
+    ? join(moduleDirectory, "../../dist")
+    : moduleDirectory;
+  return {
+    launcher: join(dist, "native/resource-launcher"),
+    binding: join(dist, "native/resource-supervisor.node"),
+    worker: join(dist, "resourceWorker.js"),
+  };
+}
+
+function read(path: string): string {
+  const text = readFileSync(path, "utf8");
+  if (text.length > 65536) throw new Error(`Oversized cgroup control: ${path}`);
+  return text.trim();
+}
+
+function writeVerified(root: string, name: string, value: string): void {
+  writeFileSync(join(root, name), value);
+  if (read(join(root, name)) !== value) throw new Error(`Cgroup ${name} did not retain ${value}`);
+}
+
+function cgroupPopulated(root: string): boolean {
+  const match = /^populated ([01])$/m.exec(read(join(root, "cgroup.events")));
+  if (!match) throw new Error("Missing populated evidence");
+  return match[1] === "1";
+}
+
+function setBudget(root: string, budget: TaskBudget): void {
+  writeVerified(root, "cpu.max", `${budget.cpuMillis * 100} 100000`);
+  writeVerified(root, "memory.max", String(budget.memoryBytes));
+  writeVerified(root, "memory.swap.max", "0");
+  writeVerified(root, "memory.oom.group", "1");
+}
+
+/** Owns only a fresh session under the caller's delegated, empty task root. */
+export class LinuxTasks {
+  readonly root: string;
+  private readonly native: NativeSupervisor;
+  private readonly clockOffset: number;
+  private readonly ancestorPaths: string[] = [];
+  private pressureBaseline: AncestorMemory[] = [];
+
+  // Fail-closed permission and capability checks precede the one owned session.
+  // fallow-ignore-next-line complexity
+  constructor(taskRoot: string, envelope: TaskBudget) {
+    if ("bun" in process.versions || Number(process.versions.node.split(".")[0]) < 22) {
+      throw new Error("Supervised Producer requires Node.js 22 or newer");
+    }
+    if (process.platform !== "linux" || process.getuid?.() !== 0) {
+      throw new Error(
+        "Supervised Producer requires a Linux root supervisor with an exclusive cgroup v2 delegation",
+      );
+    }
+    if (!taskRoot.startsWith("/sys/fs/cgroup/") || realpathSync(taskRoot) !== taskRoot) {
+      throw new Error("Expected a canonical delegated cgroup v2 task root");
+    }
+    const st = lstatSync(taskRoot);
+    if (!st.isDirectory() || st.uid !== 0 || (st.mode & 0o022) !== 0) {
+      throw new Error("Task management must be inaccessible to the unprivileged worker");
+    }
+    if (
+      cgroupPopulated(taskRoot) ||
+      readdirSync(taskRoot, { withFileTypes: true }).some((entry) => entry.isDirectory())
+    ) {
+      throw new Error("Delegation has an existing owner; refusing to reuse it");
+    }
+    const ownMembership = read("/proc/self/cgroup");
+    const taskMembership = `0::/${relative("/sys/fs/cgroup", taskRoot)}`;
+    if (ownMembership === taskMembership || ownMembership.startsWith(`${taskMembership}/`)) {
+      throw new Error("Supervisor must be outside the task budget root");
+    }
+    for (const controller of ["cpu", "memory"]) {
+      if (!read(join(taskRoot, "cgroup.controllers")).split(/\s+/).includes(controller)) {
+        throw new Error(`Missing delegated ${controller} controller`);
+      }
+    }
+    const files = runtimeFiles();
+    for (const path of [process.execPath, files.worker]) {
+      const canonical = realpathSync(path);
+      if (canonical.startsWith("/sys/fs/cgroup/")) {
+        throw new Error(`Runtime artifact would be hidden by a task mount: ${canonical}`);
+      }
+    }
+    let binding: unknown;
+    try {
+      accessSync(files.launcher, constants.X_OK);
+      binding = createRequire(import.meta.url)(files.binding);
+    } catch (cause) {
+      throw new Error(
+        "Build native helpers on this Linux host with: node node_modules/@hyperframes/producer/dist/native/build.mjs",
+        { cause },
+      );
+    }
+    if (!nativeSupervisor(binding)) throw new Error("Invalid packaged native supervisor");
+    this.native = binding;
+    this.validateBudget(envelope);
+    this.native.initialize();
+    // Sample native first: the small call skew shortens, never extends, the
+    // task deadline. G receives an absolute deadline, including spawn delay.
+    this.clockOffset = binding.monotonicMilliseconds() - performance.now();
+    // A fixed name makes competing S instances and unfinished owners conflict.
+    this.root = join(taskRoot, "hyperframes-session");
+    mkdirSync(this.root, { mode: 0o700 });
+    try {
+      writeFileSync(join(taskRoot, "cgroup.subtree_control"), "+cpu +memory");
+      setBudget(this.root, envelope);
+      writeFileSync(join(this.root, "cgroup.subtree_control"), "+cpu +memory");
+      for (let path = this.root; path !== "/sys/fs/cgroup"; path = dirname(path)) {
+        if (this.ancestorPaths.length >= 64) throw new Error("Too many visible cgroup ancestors");
+        this.ancestorPaths.push(path);
+      }
+      this.pressureBaseline = this.readAncestors();
+      memoryPressure(this.pressureBaseline, this.pressureBaseline);
+    } catch (error) {
+      rmdirSync(this.root);
+      throw error;
+    }
+  }
+
+  create(budget: TaskBudget): string {
+    this.validateBudget(budget);
+    const root = join(this.root, randomUUID());
+    // W receives a read-only bind of this node at its cgroup mount root.
+    // Management files stay root-owned and no delegation is given to W.
+    mkdirSync(root, { mode: 0o755 });
+    try {
+      setBudget(root, budget);
+    } catch (error) {
+      rmdirSync(root);
+      throw error;
+    }
+    return root;
+  }
+
+  deadlineAt(monotonicDeadline: number): number {
+    return Math.floor(monotonicDeadline + this.clockOffset);
+  }
+
+  kill(root: string): void {
+    this.assertOwned(root);
+    writeFileSync(join(root, "cgroup.kill"), "1");
+  }
+
+  reaped(root: string): boolean {
+    this.assertOwned(root);
+    return this.native.reapTask(`/${relative("/sys/fs/cgroup", root)}`) && !cgroupPopulated(root);
+  }
+
+  validateBudget(budget: TaskBudget): void {
+    const size = this.native.pageSize();
+    if (!Number.isSafeInteger(size) || size <= 0) throw new Error("Invalid Linux page size");
+    if (
+      !Number.isSafeInteger(budget.memoryBytes) ||
+      budget.memoryBytes <= 0 ||
+      budget.memoryBytes % size !== 0
+    ) {
+      throw new Error(
+        `memoryBytes must be a positive multiple of this Linux host's page size (${size})`,
+      );
+    }
+  }
+
+  pressure(): PressureObservation {
+    return memoryPressure(this.pressureBaseline, this.readAncestors());
+  }
+
+  private readAncestors(): AncestorMemory[] {
+    return this.ancestorPaths.map((path) => ({
+      path,
+      memoryCurrent: read(join(path, "memory.current")),
+      memoryHigh: read(join(path, "memory.high")),
+      memoryMax: read(join(path, "memory.max")),
+      memoryEventsLocal: read(join(path, "memory.events.local")),
+    }));
+  }
+
+  accounting(root: string): TaskAccounting {
+    this.assertOwned(root);
+    return {
+      memoryCurrent: read(join(root, "memory.current")),
+      memoryEvents: read(join(root, "memory.events")),
+      memoryEventsLocal: read(join(root, "memory.events.local")),
+      cpuStat: read(join(root, "cpu.stat")),
+    };
+  }
+
+  remove(root: string): TaskAccounting {
+    this.assertOwned(root);
+    if (!this.reaped(root)) throw new Error("Task still owns descendants");
+    const residual = this.accounting(root);
+    rmdirSync(root);
+    return residual;
+  }
+
+  close(): void {
+    rmdirSync(this.root);
+  }
+
+  private assertOwned(root: string): void {
+    if (dirname(root) !== this.root || realpathSync(root) !== root)
+      throw new Error("Task domain identity changed");
+  }
+}
