@@ -0,0 +1,35 @@
+import { describe, expect, it } from "vitest";
+import { memoryPressure, type AncestorMemory } from "./linux.js";
+
+const snapshot = (events = "high 0\nmax 0\noom 0\noom_kill 0"): AncestorMemory[] => [
+  {
+    path: "/sys/fs/cgroup/jobs/hyperframes-session",
+    memoryCurrent: "4096",
+    memoryHigh: "max",
+    memoryMax: "805306368",
+    memoryEventsLocal: events,
+  },
+];
+
+describe("ancestor-local pressure attribution", () => {
+  it("stops on an ancestor's local limit event without treating task OOM victims as ancestor pressure", () => {
+    expect(
