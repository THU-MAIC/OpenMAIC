+  // their hard budgets and cleanup owner. Synchronous grant/settlement checks
+  // also prevent the queue advancing between samples.
+  if (!pressureFailure) pressureTimer = setInterval(checkPressure, 100).unref();
+
+  // Keep acquisition, publication and the single terminal settlement in one owner.
+  // fallow-ignore-next-line complexity
+  async function execute(
+    requestText: string,
+    outputPath: string,
+    budget: TaskBudget,
+    signal: AbortSignal,
+    deadline: number,
+  ): Promise<BudgetedRenderResult> {
+    linux.validateBudget(budget);
+    checkPressure();
+    const reservation = await admission.acquire(budget, signal);
+    let domain: string | undefined;
+    let transaction: ArtifactTransaction | undefined;
+    let clean = true;
+    let published = false;
+    let residual: TaskAccounting | undefined;
+    let accountingFailure: string | undefined;
+    let cleanupFailure: string | undefined;
+    let failed = false;
+    let primary: unknown;
+    try {
+      checkPressure();
+      if (pressureFailure) throw new Error(`Producer admission is closed: ${pressureFailure}`);
