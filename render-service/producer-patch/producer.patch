+      writeFileSync(
+        requestFile,
+        JSON.stringify({ ...snapshot, outputPath: transaction.stagingPath }),
+        { flag: "wx", mode: 0o444 },
+      );
+      clean = false;
+      const receipt = await launch(
+        domain,
+        root,
+        basename(transaction.stagingPath),
+        signal,
+        deadline,
+      );
+      clean = receipt.drained && !receipt.cleanupFailed;
+      const failureDetail = [receipt.failure, receipt.diagnostics].filter(Boolean).join("\n");
+      if (!clean)
+        throw new Error(
+          `Task cleanup could not be verified; reservation quarantined at ${domain}: ${failureDetail}`,
+        );
+      // G has reaped W, revoked its business/cleanup launch permissions, and
+      // removed scratch and the task cgroup view before this point.
+      if (!linux.reaped(domain)) {
+        clean = false;
+        throw new Error("Task descendants remain after guardian exit");
+      }
+      const names = readdirSync(root);
+      const candidateName = basename(transaction.stagingPath);
+      if (names.some((name) => name !== candidateName)) {
+        clean = false;
+        throw new Error("Unknown task-owned files remain; reservation quarantined");
+      }
+      if (receipt.failure || !receipt.prepared)
+        throw new Error(failureDetail || "Render did not prepare an artifact");
+      const candidate = lstatSync(transaction.stagingPath);
+      if (
+        !candidate.isFile() ||
+        candidate.nlink !== 1 ||
+        realpathSync(transaction.stagingPath) !== transaction.stagingPath
+      ) {
+        clean = false;
+        throw new Error("Artifact has an unknown reference or file identity");
+      }
+      signal.throwIfAborted();
+      if (performance.now() >= deadline) throw new Error("render_deadline_exceeded");
+      residual = linux.remove(domain);
+      domain = undefined;
+      await transaction.commit(signal, deadline);
+      published = true;
+      // commit's final synchronous claim checks cancellation after validation.
+      // Only the empty transaction directory may remain after publication.
+      clean = !existsSync(root);
+      if (!clean)
+        cleanupFailure =
+          "Output published; transaction cleanup failed and reservation remains quarantined";
+    } catch (error) {
+      failed = true;
+      primary = error;
+    } finally {
+      if (domain) {
+        try {
+          linux.kill(domain);
+          const until = performance.now() + options.cleanupTimeoutMs;
+          while (!linux.reaped(domain) && performance.now() < until) await delay(10);
+          if (!linux.reaped(domain)) clean = false;
+          // Recursive cleanup belongs to G in A. S removes only an empty
+          // directory; a partial/unknown tree stays quarantined for its owner.
+          if (clean) residual = linux.remove(domain);
+          else residual = linux.accounting(domain);
+        } catch (error) {
+          clean = false;
+          cleanupFailure = String(error);
+          try {
+            residual ??= linux.accounting(domain);
+          } catch (error) {
+            accountingFailure = String(error);
+          }
+        }
+      }
+      if (transaction && !published) {
+        try {
+          const root = dirname(transaction.stagingPath);
+          if (existsSync(root)) {
+            const names = readdirSync(root);
+            // Cancellation can win after G retained the sole candidate.
+            // Discarding one known file is bounded; never recurse in S.
+            if (clean && names.length === 1 && names[0] === basename(transaction.stagingPath)) {
