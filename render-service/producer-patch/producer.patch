diff --git a/packages/producer/native/build.mjs b/packages/producer/native/build.mjs
new file mode 100644
index 000000000..8f49b7b50
--- /dev/null
+++ b/packages/producer/native/build.mjs
@@ -0,0 +1,52 @@
+import { spawnSync } from "node:child_process";
+import { existsSync, mkdirSync } from "node:fs";
+import { dirname, join, resolve } from "node:path";
+import { fileURLToPath } from "node:url";
+
+// Called by the package build on Linux. No install-time download, setuid bit,
+// host delegation changes or compiler invocation on a render request.
+// Both compiler invocations are explicit and must fail closed on any build error.
+// fallow-ignore-next-line complexity
+export function buildNative(directory = dirname(fileURLToPath(import.meta.url))) {
+  if (process.platform !== "linux") return;
+  const bundledHeaders = resolve(dirname(process.execPath), "../include/node");
+  const include =
+    process.env.NODE_INCLUDE_DIR ??
+    (existsSync(join(bundledHeaders, "node_api.h")) ? bundledHeaders : "/usr/include/node");
+  if (!existsSync(join(include, "node_api.h"))) {
+    throw new Error("Building supervised Producer requires Node API headers (NODE_INCLUDE_DIR)");
+  }
+  mkdirSync(directory, { recursive: true });
+  const compiler = process.env.CC ?? "cc";
+  for (const args of [
+    [
+      "-std=c11",
+      "-O2",
+      "-Wall",
+      "-Wextra",
+      "-Werror",
+      "-o",
+      join(directory, "resource-launcher"),
+      join(directory, "resource-launcher.c"),
+    ],
+    [
+      "-std=c11",
+      "-O2",
+      "-Wall",
+      "-Wextra",
+      "-Werror",
+      "-shared",
+      "-fPIC",
+      `-I${include}`,
+      "-o",
+      join(directory, "resource-supervisor.node"),
+      join(directory, "resource-supervisor.c"),
+    ],
+  ]) {
+    const result = spawnSync(compiler, args, { stdio: "inherit" });
+    if (result.error) throw result.error;
+    if (result.status !== 0) throw new Error(`Native Producer build failed (${result.status})`);
+  }
+}
+
+if (process.argv[1] && resolve(process.argv[1]) === fileURLToPath(import.meta.url)) buildNative();
