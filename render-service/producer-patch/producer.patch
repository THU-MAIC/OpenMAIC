+}
+
+export function createBudgetedProducer(input: BudgetedProducerOptions): BudgetedProducer {
+  const options = Object.freeze({ ...input });
+  for (const key of ["workerUid", "workerGid", "cleanupTimeoutMs"] as const)
+    boundedInteger(options[key], key);
+  const admission = new Admission(options);
+  const linux = new LinuxTasks(options.taskCgroupRoot, options);
+  const active = new Map<AbortController, Promise<unknown>>();
+  let closePromise: Promise<void> | undefined;
+  let pressure: PressureObservation | undefined;
+  let pressureFailure: string | undefined;
+  let pressureTimer: ReturnType<typeof setInterval> | undefined;
+  const checkPressure = () => {
