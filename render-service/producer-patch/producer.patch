+    const remaining = Math.ceil(deadline - performance.now());
+    signal.throwIfAborted();
+    if (remaining <= 0) throw new Error("render_deadline_exceeded");
+    const child = spawn(
+      files.launcher,
+      [
+        domain,
+        root,
+        candidate,
+        String(options.workerUid),
+        String(options.workerGid),
+        String(linux.deadlineAt(deadline)),
+        String(options.cleanupTimeoutMs),
+        process.execPath,
+        files.worker,
+      ],
+      {
+        stdio: ["pipe", "pipe", "pipe", "ipc"],
+        env: {
+          PATH: process.env.PATH,
+          LANG: "C.UTF-8",
+          KEEP_TEMP: "0",
+          HYPERFRAMES_EXTRACT_CACHE_DIR: "off",
+        },
+      },
+    );
+    let prepared = false,
+      drained = false,
+      cleanupFailed = false,
+      failure: string | undefined;
+    let output = "",
+      outputBytes = 0;
+    const cancel = () => {
+      if (child.stdin?.writable) child.stdin.write("C");
+    };
+    signal.addEventListener("abort", cancel, { once: true });
+    child.stdin?.on("error", () => {
+      failure ??= "Guardian lifeline failed";
+    });
+    child.on("message", (message: unknown) => {
+      if (!record(message)) {
+        failure = "Invalid worker message";
+        cancel();
+        return;
+      }
+      if (message.event === "prepared" && !prepared && !failure && !signal.aborted) {
+        prepared = true;
+        // Tell G what to retain, then ACK W before waiting for its exit.
+        child.stdin?.write("P");
+        child.send({ event: "prepared-ack" }, (error) => {
+          if (error) {
+            failure = "Prepared ACK failed";
+            cancel();
+          }
+        });
+      } else if (message.event === "failed" && typeof message.message === "string") {
+        failure = message.message.slice(0, 2048);
+        cleanupFailed = message.cleanupFailed !== false;
+      } else {
+        failure = "Unexpected worker protocol state";
+        cancel();
+      }
+    });
+    child.stdout?.on("data", (chunk: Buffer) => {
+      outputBytes += chunk.length;
+      if (outputBytes > 4096) {
+        failure = "Oversized guardian protocol";
+        cancel();
+        return;
+      }
+      output += chunk.toString("utf8");
+    });
+    let diagnosticBytes = 0;
+    let diagnostics = "";
+    child.stderr?.on("data", (chunk: Buffer) => {
+      diagnosticBytes += chunk.length;
+      diagnostics = (diagnostics + chunk.toString("utf8")).slice(-8192);
+      if (diagnosticBytes > 1024 * 1024) {
+        failure = "Worker diagnostics exceeded limit";
+        cancel();
+      }
+    });
+    // This timer bounds a stopped/uncooperative G too; S retains the fallback
+    // kill/reap responsibility, and never returns a missing G receipt.
+    let expire: (error: Error) => void = () => {};
+    const forceTerminal = () => {
+      failure ??= "Guardian deadline exceeded";
+      child.kill("SIGKILL");
+      try {
+        linux.kill(domain);
+      } catch {
+        /* Missing cleanup receipt remains quarantined. */
+      }
+      child.stdout?.destroy();
+      child.stderr?.destroy();
+      if (child.connected) child.disconnect();
+      expire(new Error(failure));
+    };
+    let watchdog = setTimeout(forceTerminal, remaining + options.cleanupTimeoutMs);
+    const guardianExited = (code: number | null, exitSignal: NodeJS.Signals | null) => {
+      if (code === 0) return;
+      failure ??= `Guardian exited with ${exitSignal ?? code}`;
+      // W and media descendants can retain G's pipes after G dies. Take
+      // fallback drain ownership on exit, before waiting for pipe EOF.
+      try {
+        linux.kill(domain);
+      } catch {
+        /* Missing cleanup receipt remains quarantined. */
+      }
+      clearTimeout(watchdog);
+      watchdog = setTimeout(
+        forceTerminal,
+        Math.max(
+          1,
+          Math.min(
+            options.cleanupTimeoutMs,
+            deadline + options.cleanupTimeoutMs - performance.now(),
+          ),
+        ),
+      );
+    };
+    child.once("exit", guardianExited);
+    try {
+      const code = await new Promise<number | null>((resolve, reject) => {
+        expire = reject;
+        child.once("error", reject);
+        child.once("close", resolve);
+        if (signal.aborted) cancel();
+        else child.stdin?.write("G");
+      });
+      if (code !== 0) failure ??= `Guardian exited with ${code}`;
+      try {
+        const events: unknown[] = output
+          .trim()
+          .split("\n")
+          .filter(Boolean)
+          .map((line) => JSON.parse(line));
+        const last = events.at(-1);
+        drained =
+          code === 0 &&
+          record(last) &&
+          last.event === "drained" &&
+          typeof last.workerStatus === "number";
+        prepared = prepared && record(last) && last.prepared === true && last.workerStatus === 0;
+      } catch {
+        failure = "Invalid guardian receipt";
+      }
+      return { drained, prepared, cleanupFailed, failure, diagnostics };
+    } finally {
+      clearTimeout(watchdog);
+      child.removeListener("exit", guardianExited);
+      signal.removeEventListener("abort", cancel);
+      child.stdin?.end();
+    }
+  }
+
+  return {
+    async render(request, budget, run) {
+      boundedInteger(run.timeoutMs, "timeoutMs");
+      const requestText = requestSnapshot(request);
+      const cancel = new AbortController();
+      const signal = run.signal ? AbortSignal.any([cancel.signal, run.signal]) : cancel.signal;
+      const deadline = performance.now() + run.timeoutMs;
+      const timer = setTimeout(
+        () => cancel.abort(new Error("render_deadline_exceeded")),
+        run.timeoutMs,
+      );
+      const work = execute(requestText, request.outputPath, { ...budget }, signal, deadline);
+      active.set(cancel, work);
+      void work
+        .finally(() => {
+          clearTimeout(timer);
+          active.delete(cancel);
+        })
+        .catch(() => {});
+      return work;
+    },
+    status: () => ({ ...admission.snapshot(), pressure, pressureFailure }),
+    close() {
+      closePromise ??= (async () => {
+        admission.close();
+        clearInterval(pressureTimer);
+        for (const cancel of active.keys()) cancel.abort(new Error("Producer closing"));
+        await Promise.allSettled(active.values());
+        if (admission.snapshot().quarantined)
+          throw new Error("Producer has quarantined task ownership");
+        linux.close();
+      })();
+      return closePromise;
+    },
+  };
+}
