diff --git a/packages/producer/src/resourceWorker.ts b/packages/producer/src/resourceWorker.ts
new file mode 100644
index 000000000..11946e24b
--- /dev/null
+++ b/packages/producer/src/resourceWorker.ts
@@ -0,0 +1,90 @@
+import { readFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { normalizeErrorMessage } from "./utils/errorMessage.js";
+
+// This entry is exec'd by the native launcher only after CLONE_INTO_CGROUP.
+// Heavy renderer imports, request validation and disposal all belong to W.
+const cancel = new AbortController();
+let cleanupFailed = false;
+process.once("SIGTERM", () => cancel.abort(new Error("render_cancelled")));
+process.once("disconnect", () => cancel.abort(new Error("supervisor_disconnected")));
+
+function send(message: object): Promise<void> {
+  return new Promise((resolve, reject) => {
+    if (!process.send) {
+      reject(new Error("Missing supervisor IPC"));
+      return;
+    }
+    process.send(message, (error) => (error ? reject(error) : resolve()));
+  });
+}
+
+try {
+  const file = process.argv[2];
+  if (!file || !process.send) throw new Error("Worker requires a supervisor request");
+  const raw = readFileSync(file, "utf8");
+  if (Buffer.byteLength(raw) > 1024 * 1024) throw new Error("Oversized render request");
+  const { parseRenderRequest, renderConfigFromRequest } = await import("./renderRequest.js");
+  const { createRenderJob, executeRenderJob } = await import("./services/renderOrchestrator.js");
+  const { RenderCleanupError } = await import("./services/render/renderExecutionContext.js");
+  const request = parseRenderRequest(raw);
+  if (
+    request.options.debug ||
+    request.options.distributed ||
+    request.options.format === "png-sequence"
+  ) {
+    throw new Error(
+      "Supervised rendering currently supports local file outputs without retained debug state",
+    );
+  }
+  const config = renderConfigFromRequest(request);
+  // Cross-task caches would leave a second owner outside this reservation.
+  // Keep the existing cache implementation, confined to this task's temp root.
+  config.producerConfig = {
+    ...request.options.engineConfig,
+    extractCacheDir: join(tmpdir(), "extraction-cache"),
+    debug: false,
+  };
+  const job = createRenderJob(config);
+  try {
+    await executeRenderJob(job, request.projectDir, request.outputPath, undefined, cancel.signal, {
+      requireCleanup: true,
+    });
+  } catch (error) {
+    cleanupFailed = error instanceof RenderCleanupError;
+    throw error;
+  }
+  cancel.signal.throwIfAborted();
+  // ACK validation and disconnect cancellation jointly guard this one handoff.
+  const ack = new Promise<void>((resolve, reject) => {
+    // fallow-ignore-next-line complexity
+    process.once("message", (message: unknown) => {
+      if (
+        typeof message === "object" &&
+        message !== null &&
+        "event" in message &&
+        message.event === "prepared-ack"
+      )
+        resolve();
+      else reject(new Error("Invalid prepared acknowledgement"));
+    });
+    cancel.signal.addEventListener("abort", () => reject(cancel.signal.reason), { once: true });
+  });
+  await send({ event: "prepared" });
+  await ack;
+  process.disconnect?.();
+  // G owns any remaining browser/encoder descendants and the final drain.
+  process.exit(0);
+} catch (error) {
+  try {
+    await send({
+      event: "failed",
+      cleanupFailed,
+      message: normalizeErrorMessage(error).slice(0, 2048),
+    });
+  } catch {
+    /* The guardian's lifeline still triggers cleanup if S is gone. */
+  }
+  process.exit(1);
+}
