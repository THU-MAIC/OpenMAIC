diff --git a/packages/producer/src/resources/admission.test.ts b/packages/producer/src/resources/admission.test.ts
new file mode 100644
index 000000000..5bcc2cd12
--- /dev/null
+++ b/packages/producer/src/resources/admission.test.ts
@@ -0,0 +1,87 @@
+import { describe, expect, it } from "vitest";
+import { Admission } from "./admission.js";
+
+const budget = { cpuMillis: 500, memoryBytes: 128 * 1024 * 1024 };
+const signal = () => new AbortController().signal;
+const create = () =>
+  new Admission({
+    cpuMillis: 1000,
+    memoryBytes: budget.memoryBytes * 2,
+    maxActive: 4,
+    maxQueued: 2,
+  });
+
+describe("supervisor admission ownership", () => {
+  it("atomically accounts concurrent CPU and memory reservations", async () => {
+    const owner = create();
+    const [a, b] = await Promise.all([
+      owner.acquire(budget, signal()),
+      owner.acquire(budget, signal()),
+    ]);
+    let started = false;
+    const next = owner.acquire(budget, signal()).then((r) => {
+      started = true;
+      return r;
+    });
+    await Promise.resolve();
+    expect(started).toBe(false);
+    expect(owner.snapshot()).toMatchObject({ active: 2, queued: 1, cpuMillis: 1000 });
+    a.settle(true);
+    const c = await next;
+    expect(owner.snapshot().active).toBe(2);
+    a.settle(true);
+    expect(owner.snapshot().active).toBe(2);
+    b.settle(true);
+    c.settle(true);
+    expect(owner.snapshot()).toMatchObject({ active: 0, cpuMillis: 0, memoryBytes: 0 });
+  });
+
+  it("removes a cancelled waiter before returning the competing permit", async () => {
+    const owner = create();
+    const a = await owner.acquire({ cpuMillis: 1000, memoryBytes: budget.memoryBytes }, signal());
+    const cancel = new AbortController();
+    const waiting = owner.acquire(budget, cancel.signal);
+    const rejected = expect(waiting).rejects.toThrow("deadline");
+    cancel.abort(new Error("deadline"));
+    a.settle(true);
+    await rejected;
+    expect(owner.snapshot()).toMatchObject({ active: 0, queued: 0 });
+  });
+
+  it("returns B while A remains owned, then supports cumulative work beyond the envelope", async () => {
+    const owner = create();
+    const a = await owner.acquire(budget, signal());
+    for (let i = 0; i < 10; i++) {
+      const b = await owner.acquire(budget, signal());
+      b.settle(true);
+      expect(owner.snapshot().memoryBytes).toBe(budget.memoryBytes);
+    }
+    a.settle(true);
+  });
+
+  it("quarantines failed cleanup without returning capacity or admitting another task", async () => {
+    const owner = create();
+    const a = await owner.acquire(budget, signal());
+    const b = await owner.acquire(budget, signal());
+    const waiting = expect(owner.acquire(budget, signal())).rejects.toThrow("closed");
+    a.settle(false);
+    a.settle(true);
+    b.settle(true);
+    await waiting;
+    expect(owner.snapshot()).toMatchObject({
+      active: 0,
+      quarantined: 1,
+      memoryBytes: budget.memoryBytes,
+      closed: true,
+    });
+    await expect(owner.acquire(budget, signal())).rejects.toThrow("closed");
+  });
+
+  it("bounds the queue and rejects impossible budgets without starting work", async () => {
+    const owner = new Admission({ ...budget, maxActive: 1, maxQueued: 0 });
+    await expect(owner.acquire({ ...budget, cpuMillis: 501 }, signal())).rejects.toThrow("exceeds");
+    const a = await owner.acquire(budget, signal());
+    await expect(owner.acquire(budget, signal())).rejects.toThrow("full");
+    a.settle(true);
+  });
+});
diff --git a/packages/producer/src/resources/admission.ts b/packages/producer/src/resources/admission.ts
new file mode 100644
index 000000000..5e53f1cdd
--- /dev/null
+++ b/packages/producer/src/resources/admission.ts
@@ -0,0 +1,148 @@
+export interface TaskBudget {
+  /** CPU bandwidth in thousandths of one CPU, enforced over 100 ms periods. */
+  cpuMillis: number;
+  memoryBytes: number;
+}
+
+export interface AdmissionLimits extends TaskBudget {
+  maxActive: number;
+  maxQueued: number;
+}
+
+export interface Reservation {
+  /** Called only by the supervisor after its terminal ownership checks. */
+  settle(clean: boolean): void;
+}
+
+interface Waiting {
+  budget: TaskBudget;
+  signal: AbortSignal;
+  resolve: (reservation: Reservation) => void;
+  reject: (error: unknown) => void;
+  abort: () => void;
+}
+
+function integer(value: number, name: string, minimum: number): void {
+  if (
+    !Number.isSafeInteger(value) ||
+    value < minimum ||
+    (name === "cpuMillis" && !Number.isSafeInteger(value * 100))
+  ) {
+    throw new Error(`${name} must be a safe integer >= ${minimum}`);
+  }
+}
+
+/** Private ledger of the supervised Producer. No separate scheduling service. */
+export class Admission {
+  private readonly limits: Readonly<AdmissionLimits>;
+  private readonly waiting: Waiting[] = [];
+  private active = 0;
+  private cpuMillis = 0;
+  private memoryBytes = 0;
+  private quarantined = 0;
+  private closed = false;
+
+  constructor(limits: AdmissionLimits) {
+    for (const field of ["cpuMillis", "memoryBytes", "maxActive"] as const) {
+      integer(limits[field], field, 1);
+    }
+    integer(limits.maxQueued, "maxQueued", 0);
+    this.limits = Object.freeze({ ...limits });
+  }
+
+  snapshot() {
+    return Object.freeze({
+      active: this.active,
+      queued: this.waiting.length,
+      cpuMillis: this.cpuMillis,
+      memoryBytes: this.memoryBytes,
+      quarantined: this.quarantined,
+      closed: this.closed,
+    });
+  }
+
+  acquire(input: TaskBudget, signal: AbortSignal): Promise<Reservation> {
+    integer(input.cpuMillis, "cpuMillis", 10);
+    integer(input.memoryBytes, "memoryBytes", 1);
+    const budget = Object.freeze({ ...input });
+    if (budget.cpuMillis > this.limits.cpuMillis || budget.memoryBytes > this.limits.memoryBytes) {
+      return Promise.reject(new Error("Task budget exceeds the Producer envelope"));
+    }
+    if (this.closed) return Promise.reject(new Error("Producer admission is closed"));
+    if (signal.aborted) return Promise.reject(signal.reason);
+    if (this.waiting.length === 0 && this.fits(budget)) {
+      return Promise.resolve(this.reserve(budget));
+    }
+    if (this.waiting.length >= this.limits.maxQueued) {
+      return Promise.reject(new Error("Producer admission queue is full"));
+    }
+    return new Promise((resolve, reject) => {
+      const item: Waiting = {
+        budget,
+        signal,
+        resolve,
+        reject,
+        abort: () => {
+          const index = this.waiting.indexOf(item);
+          if (index < 0) return;
+          this.waiting.splice(index, 1);
+          signal.removeEventListener("abort", item.abort);
+          reject(signal.reason);
+          this.admit();
+        },
+      };
+      this.waiting.push(item);
+      signal.addEventListener("abort", item.abort, { once: true });
+    });
+  }
+
+  close(reason: Error = new Error("Producer admission is closed")): void {
+    this.closed = true;
+    for (const item of this.waiting.splice(0)) {
+      item.signal.removeEventListener("abort", item.abort);
+      item.reject(reason);
+    }
+  }
+
+  private fits(budget: TaskBudget): boolean {
+    return (
+      this.active < this.limits.maxActive &&
+      budget.cpuMillis <= this.limits.cpuMillis - this.cpuMillis &&
+      budget.memoryBytes <= this.limits.memoryBytes - this.memoryBytes
+    );
+  }
+
+  private reserve(budget: TaskBudget): Reservation {
+    this.active++;
+    this.cpuMillis += budget.cpuMillis;
+    this.memoryBytes += budget.memoryBytes;
+    let settled = false;
+    return {
+      settle: (clean) => {
+        if (settled) return;
+        settled = true;
+        if (!clean) {
+          this.active--;
+          this.quarantined++;
+          this.close();
+          return;
+        }
+        this.active--;
+        this.cpuMillis -= budget.cpuMillis;
+        this.memoryBytes -= budget.memoryBytes;
+        this.admit();
+      },
+    };
+  }
+
+  private admit(): void {
+    while (!this.closed) {
+      const item = this.waiting[0];
+      if (!item || !this.fits(item.budget)) return;
+      this.waiting.shift();
+      item.signal.removeEventListener("abort", item.abort);
+      if (item.signal.aborted) item.reject(item.signal.reason);
+      else item.resolve(this.reserve(item.budget));
+    }
+  }
+}
