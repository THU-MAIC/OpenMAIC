+export interface TaskSettlement {
+  published: boolean;
+  cleanupVerified: boolean;
+  reservationReturned: boolean;
+  residual?: TaskAccounting;
+  accountingFailure?: string;
+  cleanupFailure?: string;
+  pressure?: PressureObservation;
+  pressureFailure?: string;
