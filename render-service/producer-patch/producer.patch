+                        "0::" + domain.slice("/sys/fs/cgroup".length),
+                        "Observed media descendant escaped A",
+                      );
+                      observed.set(pid, row);
+                      queue.push(pid);
+                    }
+                  }
+                }
+              } catch (error) {
+                observationError = error;
+                abort.abort(error);
+              }
+            }, 10);
+            let result;
+            try {
+              result = await producer.render(makeRequest(join(work, "output.mp4")), budget, {
+                timeoutMs: 120000,
+                signal: abort.signal,
+              });
+            } finally {
+              clearInterval(sampler);
+              attempt.descendants = [...observed.values()];
+              attempt.guardians = [...guardians];
+              attempt.observationError = observationError?.stack ?? null;
+              save();
+            }
+            if (observationError) throw observationError;
+            const descendants = [...observed.values()];
+            assert(
+              descendants.some((p) => p.cmdline.includes("chrome")),
+              "Missing actual Chrome descendant evidence",
+            );
+            assert(
+              descendants.some((p) => p.cmdline.includes("ffmpeg")),
+              "Missing actual FFmpeg descendant evidence",
+            );
+            descendants.forEach((p) =>
+              assert.equal(status(p.pid), null, "Final descendants must be reaped"),
+            );
+            assert(result.reservationReturned);
+            assert(fs.statSync(result.outputPath).size > 0);
+            assert.match(result.residual.cpuStat, /usage_usec [1-9]/);
+            assert.deepEqual(tasks(), []);
+            assert.equal(producer.status().memoryBytes, 0);
+            guardians.forEach((pid) => assert.equal(status(pid), null, "Guardian must be reaped"));
+            assert.deepEqual(fs.readdirSync(work), ["output.mp4"], "Temporary objects remain");
+            const media = JSON.parse(
+              execFileSync(
+                "/usr/bin/ffprobe",
+                [
+                  "-v",
+                  "error",
+                  "-count_frames",
+                  "-show_streams",
+                  "-show_format",
+                  "-of",
+                  "json",
+                  result.outputPath,
+                ],
+                { encoding: "utf8", timeout: 10000, maxBuffer: 65536 },
+              ),
+            );
+            const video = media.streams.filter((stream) => stream.codec_type === "video");
+            assert.equal(video.length, 1);
+            assert.equal(video[0].codec_name, "h264");
+            assert(
+              Number(video[0].nb_read_frames) > 0 && video[0].width > 0 && video[0].height > 0,
+            );
+            assert(Number(media.format.duration) > 0);
+            execFileSync(
+              "/usr/bin/ffmpeg",
+              ["-v", "error", "-xerror", "-i", result.outputPath, "-f", "null", "-"],
+              { timeout: 15000, maxBuffer: 65536 },
+            );
+            const bytes = fs.statSync(result.outputPath).size;
+            const sha256 = createHash("sha256")
+              .update(fs.readFileSync(result.outputPath))
+              .digest("hex");
+            let artifact = null;
+            if (stage === "pipeline-normal" || stage === "pipeline") {
+              assert(bytes <= 1024 * 1024, "Normal export exceeds existing evidence allowance");
+              artifact = `normal-output-${i + 1}.mp4`;
+              fs.copyFileSync(result.outputPath, join(artifactDir, artifact));
+            }
+            Object.assign(attempt, result, {
+              phase: "verified",
+              bytes,
+              sha256,
+              artifact,
+              media,
+              decoded: true,
+              finalReaped: true,
+              temporaryObjectsRemoved: true,
+              remainingTasks: tasks(),
+              reservation: producer.status(),
+            });
+            save();
+          }
+          await producer.close();
+          assert(!exists(session));
+          fs.rmSync(work, { recursive: true });
+          results.forEach((attempt) =>
+            Object.assign(attempt, {
+              sessionRemoved: !exists(session),
+              workRemoved: !exists(work),
+            }),
+          );
+          return results;
+        } catch (error) {
+          const attempt = results.at(-1);
+          if (attempt) {
+            attempt.error = String(error);
+            attempt.reservationAfterError = producer.status();
+            attempt.remainingTasksAfterError = tasks();
+            attempt.reapedAfterError = attempt.descendants.map((p) => ({
+              pid: p.pid,
+              absent: status(p.pid) === null,
+            }));
+          }
+          try {
+            await producer.close();
+          } catch (closeError) {
+            if (attempt) attempt.closeError = String(closeError);
+          }
+          save();
+          throw error;
+        }
+      });
+      if (stage !== "pipeline-normal") {
+        const previousArtifact = join(artifactDir, "normal-output-1.mp4");
+        const previousHash = hashFile(previousArtifact);
+        await test("startup-oom-return", async () => {
+          const work = fs.mkdtempSync(join(workRoot, "oom-"));
+          fs.chmodSync(work, 0o755);
+          const output = join(work, "output.mp4");
+          fs.copyFileSync(previousArtifact, output);
+          const producer = createBudgetedProducer(options);
+          let fd,
+            memory = "",
+            observationError,
+            settlement;
+          const sample = () => {
+            try {
+              const domain = tasks()[0];
+              if (fd === undefined && domain) fd = fs.openSync(join(domain, "memory.events"), "r");
+              if (fd !== undefined) {
+                const buffer = Buffer.alloc(4096);
+                const text = buffer
+                  .subarray(0, fs.readSync(fd, buffer, 0, buffer.length, 0))
+                  .toString();
+                if (
+                  statValue(text, "oom_kill") > statValue(memory || "oom_kill 0", "oom_kill") ||
+                  !memory
+                )
+                  memory = text;
+              }
+            } catch (error) {
+              // Offline cgroup files can disappear after final removal. Never
+              // infer OOM from that; require a previously observed kernel counter.
+              if (error.code !== "ENOENT" && error.code !== "ENODEV") observationError = error;
+            }
+          };
+          const timer = setInterval(sample, 10);
+          try {
+            await assert.rejects(
+              producer.render(
+                makeRequest(output),
+                { ...budget, memoryBytes: 64 * 1024 * 1024 },
+                { timeoutMs: 120000 },
+              ),
+              (error) => {
+                settlement = error.settlement;
+                return Boolean(settlement?.cleanupVerified && settlement.reservationReturned);
+              },
+            );
+            assert(statValue(settlement.residual.memoryEventsLocal, "oom") > 0);
+            assert.deepEqual(settlement.pressure.triggers, []);
+            sample();
+            if (observationError) throw observationError;
+            assert(statValue(memory, "oom_kill") > 0, "A failed render alone is not OOM evidence");
+            assert.equal(hashFile(output), previousHash);
+            assert.equal(producer.status().memoryBytes, 0);
+            assert.deepEqual(tasks(), []);
+            const recovery = await proveReturnedCapacity(producer, work);
+            assert.equal(hashFile(output), previousHash);
+            await producer.close();
+            fs.rmSync(work, { recursive: true });
+            return {
+              coverage: "startup-or-media-oom-not-media-gated",
+              memory,
+              settlement,
+              memoryLimit: 64 * 1024 * 1024,
+              finalReaped: true,
+              reservationReturned: true,
+              previousOutputPreserved: true,
+              previousOutputSha256: previousHash,
+              recovery,
+            };
+          } finally {
+            clearInterval(timer);
+            if (fd !== undefined) fs.closeSync(fd);
+            try {
+              await producer.close();
+            } catch {}
+          }
+        });
+        for (const kind of [
+          "media-oom",
+          "cancel",
+          "deadline",
+          "guardian-death",
+          "supervisor-death",
+          "unknown-reference",
+          "ancestor-pressure",
+        ]) {
+          await test(`real-${kind}`, async (row) => {
+            const work = fs.mkdtempSync(join(workRoot, "failure-"));
+            fs.chmodSync(work, 0o755);
+            const output = join(work, "output.mp4");
+            fs.copyFileSync(previousArtifact, output);
+            const request = makeRequest(output, 30),
+              observed = [],
+              cancel = new AbortController();
+            let producer, child, done, failure, memoryFd, queued;
+            const started = performance.now(),
+              timeoutMs = kind === "deadline" ? 15000 : 120000;
+            const fault = { kind, mediaReady: false, observed, timeoutMs, injection: null };
+            row.evidence = fault;
+            save();
+            if (kind === "supervisor-death") {
+              const config = join(work, "case.json");
+              write(config, { resources: entries[0], options, request, budget });
+              ({ child, done } = childProcess([self, "producer-child", config]));
+            } else {
+              producer = createBudgetedProducer(options);
+              done = producer
+                .render(request, budget, {
+                  timeoutMs,
+                  signal: cancel.signal,
+                })
+                .then(
+                  () => {
+                    throw new Error("Faulted render unexpectedly succeeded");
+                  },
+                  (error) => {
+                    failure = String(error);
+                    fault.settlement = error.settlement ?? null;
+                  },
+                );
+            }
+            let settled = false,
+              outcome;
+            void done.then(
+              (value) => {
+                settled = true;
+                outcome = value;
+              },
+              (error) => {
+                settled = true;
+                outcome = { error: String(error) };
+              },
+            );
+            let domain, worker, guardian;
+            try {
+              await until(() => {
+                if (settled)
+                  throw new Error(
+                    `Render exited before media injection: ${failure ?? JSON.stringify(outcome)}`,
+                  );
+                domain = tasks()[0];
+                if (!domain) return false;
+                const gate = mediaGate(pids(domain).map(status), domain);
+                if (!gate) return false;
+                worker = gate.worker;
+                observed.push(...gate.observed);
+                Object.assign(fault, { mediaReady: true, media: gate.media, domain });
+                save();
+                guardian = Number(/^PPid:\s+(\d+)$/m.exec(worker.status)?.[1]);
+                return guardian > 0;
+              });
+              // Freeze the observed media tree, not just an exec'd Node process.
+              for (const proc of observed) {
+                try {
+                  process.kill(proc.pid, "SIGSTOP");
+                } catch (error) {
+                  if (error.code !== "ESRCH") throw error;
+                }
+              }
+              const injectionGate = mediaGate(pids(domain).map(status), domain);
+              assert(injectionGate, "Renderer and encoder must remain alive at injection");
+              observed.splice(0, observed.length, ...injectionGate.observed);
+              fault.media = injectionGate.media;
+              fault.injection = {
+                kind,
+                atElapsedMs: performance.now() - started,
+                guardian,
+                action: kind === "deadline" ? "wait-existing-deadline" : kind,
+              };
+              save();
+              assert.match(read(join(domain, "cpu.max")), /^100000 100000$/);
+              assert.equal(read(join(domain, "memory.max")), String(budget.memoryBytes));
+              fault.previousOutputSha256 = previousHash;
+              fault.reservationAtInjection = producer ? producer.status() : null;
+              save();
+              if (kind === "unknown-reference") {
+                const reserved = fs
+                  .readdirSync(work)
+                  .find((name) => fs.statSync(join(work, name)).isDirectory());
+                assert(reserved);
+                const source = join(work, reserved, "scratch", "retained");
+                fs.writeFileSync(source, "reference");
+                fs.linkSync(source, join(work, "retained-link"));
+              }
+              if (kind === "ancestor-pressure") {
+                queued = producer
+                  .render(makeRequest(join(work, "queued.mp4")), budget, { timeoutMs: 120000 })
+                  .then(
+                    () => {
+                      throw new Error("Ancestor pressure admitted queued work");
+                    },
+                    (error) => {
+                      fault.queuedRejection = String(error);
+                    },
+                  );
+                await until(() => producer.status().queued === 1);
+                fault.ancestorMemoryMaxBefore = read(join(session, "memory.max"));
+                fault.ancestorEventsBefore = read(join(session, "memory.events.local"));
+                fault.injectedAncestorMemoryMax = 64 * 1024 * 1024;
+                // Test owner changes only this session, below the unchanged
+                // outer platform boundary. A still has its original 768 MiB.
+                fs.writeFileSync(
+                  join(session, "memory.max"),
+                  String(fault.injectedAncestorMemoryMax),
+                );
+                fault.ancestorEventsAfter = read(join(session, "memory.events.local"));
+                assert(
+                  statValue(fault.ancestorEventsAfter, "oom") >
+                    statValue(fault.ancestorEventsBefore, "oom"),
+                );
+                save();
+              } else if (kind === "media-oom") {
+                memoryFd = fs.openSync(join(domain, "memory.events"), "r");
+                fault.oomBefore = read(join(domain, "memory.events"));
+                fault.injectedMemoryMax = 64 * 1024 * 1024;
+                fs.writeFileSync(join(domain, "memory.max"), String(fault.injectedMemoryMax));
+                const buffer = Buffer.alloc(4096);
+                fault.oomAfter = buffer
+                  .subarray(0, fs.readSync(memoryFd, buffer, 0, buffer.length, 0))
+                  .toString();
+                assert(
+                  statValue(fault.oomAfter, "oom_kill") > statValue(fault.oomBefore, "oom_kill"),
+                );
+                save();
+              } else if (kind === "guardian-death") process.kill(guardian, "SIGKILL");
+              else if (kind === "supervisor-death") child.kill("SIGKILL");
+              else if (kind !== "deadline") cancel.abort(new Error(kind));
+              const terminal = await Promise.race([
+                done,
+                delay(25000, undefined, { ref: false }).then(() => {
+                  throw new Error("Product cleanup deadline");
+                }),
+              ]);
+              // S's exit is not G's cleanup receipt. An empty cgroup excludes
+              // zombies; wait for G to reap the whole observed tree as well.
+              await until(
+                () =>
+                  pids(domain).length === 0 &&
+                  status(worker.pid) === null &&
+                  observed.every((proc) => status(proc.pid) === null),
+              );
+              for (const proc of observed)
+                assert.equal(status(proc.pid), null, "Observed media descendant must be reaped");
+              assert.equal(hashFile(output), previousHash);
+              fault.reaped = observed.map((proc) => ({
+                pid: proc.pid,
+                absent: status(proc.pid) === null,
+              }));
+              fault.emptyDomainBeforeTestCleanup = pids(domain).length === 0;
+              if (kind === "supervisor-death") {
+                assert.equal(terminal.signal, "SIGKILL");
+                const binding = createRequire(import.meta.url)(
+                  join(pkg, "dist/native/resource-supervisor.node"),
+                );
+                await until(() => {
+                  binding.reapTask(read("/proc/self/cgroup").slice(3));
+                  return !status(guardian);
+                });
+                assert.throws(() => createBudgetedProducer(options), /existing owner/);
+                assert.equal(
+                  fs.readdirSync(work).filter((name) => fs.statSync(join(work, name)).isDirectory())
+                    .length,
+                  0,
+                );
+                // Platform test owner may remove the empty, unreusable dead-S session.
+                fs.rmdirSync(domain);
+                fs.rmdirSync(session);
+              } else if (kind === "guardian-death" || kind === "unknown-reference") {
+                assert.match(failure, /cleanup could not be verified|quarantined/);
+                assert.equal(producer.status().quarantined, 1);
+                assert.equal(producer.status().memoryBytes, budget.memoryBytes);
+                assert.equal(producer.status().cpuMillis, budget.cpuMillis);
+                await assert.rejects(
+                  producer.render(request, budget, { timeoutMs: 1000 }),
+                  /closed|quarantined/,
+                );
+                fault.admissionRejectedWhileQuarantined = true;
+                await assert.rejects(producer.close(), /quarantined/);
+                assert.throws(() => createBudgetedProducer(options), /existing owner/);
+                // Known injected leftovers are now transferred to the platform test owner.
+                fs.rmdirSync(domain);
+                fs.rmdirSync(session);
+              } else if (kind === "ancestor-pressure") {
+                await queued;
+                assert.match(fault.queuedRejection, /admission is closed/);
+                assert(producer.status().closed);
+                assert.equal(producer.status().memoryBytes, 0);
+                assert.deepEqual(tasks(), []);
+                assert(fault.settlement.cleanupVerified && fault.settlement.reservationReturned);
+                assert.equal(statValue(fault.settlement.residual.memoryEventsLocal, "oom"), 0);
+                assert(statValue(fault.settlement.residual.memoryEventsLocal, "oom_kill") > 0);
+                assert(
+                  producer
+                    .status()
+                    .pressure.triggers.some((row) => row.path === session && row.event === "oom"),
+                );
+                assert.deepEqual(fs.readdirSync(work), ["output.mp4"]);
+                fault.temporaryObjectsRemoved = true;
+                await producer.close();
+              } else {
+                assert(failure, "Fault must reject the active render");
+                if (kind === "deadline")
+                  assert(
+                    performance.now() - started >= timeoutMs - 20,
+                    "Failure preceded the real deadline",
+                  );
+                assert.equal(producer.status().memoryBytes, 0);
+                assert(fault.settlement.cleanupVerified && fault.settlement.reservationReturned);
+                assert.match(fault.settlement.residual.cpuStat, /usage_usec [1-9]/);
+                assert.equal(producer.status().pressureFailure, undefined);
+                assert.deepEqual(producer.status().pressure.triggers, []);
+                if (kind === "media-oom")
+                  assert(statValue(fault.settlement.residual.memoryEventsLocal, "oom") > 0);
+                assert.deepEqual(tasks(), []);
+                fault.recovery = await proveReturnedCapacity(producer, work);
+                assert.equal(hashFile(output), previousHash);
+                assert.deepEqual(
+                  fs.readdirSync(work).sort(),
+                  ["output.mp4", "recovery.mp4"],
+                  "Task temporary objects remain",
+                );
+                fault.temporaryObjectsRemoved = true;
+                await producer.close();
+              }
+              fs.rmSync(work, { recursive: true });
+              Object.assign(fault, {
+                guardian,
+                failure: failure ?? null,
+                terminal: terminal ?? null,
+                elapsedMs: performance.now() - started,
+                previousOutputPreserved: true,
+                finalReaped: true,
+                reservation: producer ? producer.status() : null,
+              });
+              return fault;
+            } finally {
+              if (memoryFd !== undefined) fs.closeSync(memoryFd);
+              if (child && child.exitCode === null && child.signalCode === null)
+                child.kill("SIGKILL");
+              if (producer) {
+                cancel.abort();
+                try {
+                  await producer.close();
+                } catch {}
+              }
+              Object.assign(fault, { failure: failure ?? null, outcome: outcome ?? null });
+              row.evidence = fault;
+              save();
+            }
+          });
+        }
+      }
+    }
+    report.status = "PASS";
+    report.finishedMonotonicMs = Number(process.hrtime.bigint()) / 1e6;
+    save();
+  } catch (error) {
+    report.status = "FAIL";
+    report.finishedMonotonicMs = Number(process.hrtime.bigint()) / 1e6;
+    report.error = error.stack;
+    save();
+    throw error;
+  }
+}
