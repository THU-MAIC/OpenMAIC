+// Capture before waiting, and publish on every event. Failed startup must leave
+// the same argv/exit/stream evidence as a successful case.
+export function observeLauncher(child, argv, persist = () => {}) {
+  const evidence = {
+    argv,
+    pid: child.pid ?? null,
+    stdout: "",
+    stderr: "",
+    stdoutBytes: 0,
+    stderrBytes: 0,
+    exitObserved: false,
+    closed: false,
+    code: null,
+    signal: null,
+    spawnError: null,
+    first: null,
+    descendants: [],
+  };
+  for (const stream of ["stdout", "stderr"])
+    child[stream]?.on("data", (chunk) => {
+      evidence[stream + "Bytes"] += chunk.length;
+      const text = evidence[stream] + chunk.toString();
+      evidence[stream] = text.length > 16384 ? text.slice(0, 8192) + text.slice(-8192) : text;
+      persist(evidence);
+    });
+  child.on("message", (message) => {
+    if (message.event === "native-ready") evidence.first = message.first;
+    if (message.event === "descendants") evidence.descendants = message.pids;
+    persist(evidence);
+  });
