+import { describe, expect, it } from "vitest";
+import { spawn } from "node:child_process";
+import { mkdtempSync, readFileSync, rmSync, writeFileSync } from "node:fs";
+import { join } from "node:path";
+import { tmpdir } from "node:os";
+import { mediaGate, observeLauncher } from "./installed-linux-cases.mjs";
+
+describe("installed test evidence regressions without cgroups", () => {
+  it("retains stderr and exit status when a child exits before readiness", async () => {
+    const root = mkdtempSync(join(tmpdir(), "producer-evidence-"));
+    const path = join(root, "failure.json");
+    const child = spawn(
+      process.execPath,
+      [
+        "-e",
+        'process.stderr.write("resource-launcher: worker exec: errno=13 (Permission denied)\\n"); process.exitCode=125;',
+      ],
+      { stdio: ["ignore", "pipe", "pipe"] },
+    );
+    const observation = observeLauncher(child, child.spawnargs, (evidence: unknown) =>
+      writeFileSync(path, JSON.stringify(evidence)),
+    );
+    try {
+      await expect(observation.waitReady(() => false, 3000)).rejects.toThrow(
+        "Launcher exited before readiness",
+      );
+      await observation.done;
+      expect(JSON.parse(readFileSync(path, "utf8"))).toMatchObject({
+        code: 125,
+        signal: null,
+        closed: true,
+        exitObserved: true,
+        first: null,
+        descendants: [],
+      });
+      expect(readFileSync(path, "utf8")).toContain("errno=13");
+      expect(observation.evidence.argv).toEqual(child.spawnargs);
+    } finally {
+      if (!observation.evidence.closed) child.kill("SIGKILL");
+      rmSync(root, { recursive: true, force: true });
+    }
+  });
+
+  it("does not call Node-only startup a media injection point", () => {
+    const domain = "/sys/fs/cgroup/test/task";
+    const worker = {
+      pid: 1,
+      status: "State:\tS",
+      cmdline: "/node\0/resourceWorker.js\0",
+      cgroup: "0::/test/task",
+    };
+    expect(mediaGate([worker], domain)).toBeNull();
+    const chrome = { ...worker, pid: 2, cmdline: "/browser/chrome --type=renderer --headless" };
+    const encoder = {
+      ...worker,
+      pid: 3,
+      cmdline: "/usr/bin/ffmpeg\0-i\0-\0-c:v\0libx264\0output.mp4\0",
+    };
+    expect(mediaGate([worker, chrome], domain)).toBeNull();
+    expect(mediaGate([worker, chrome, encoder], domain)?.media).toEqual([chrome, encoder]);
+    expect(
+      mediaGate([worker, chrome, { ...encoder, cmdline: "/usr/bin/ffmpeg\0-version\0" }], domain),
+    ).toBeNull();
+    expect(mediaGate([worker, { ...chrome, status: "State:\tZ" }, encoder], domain)).toBeNull();
+    expect(() =>
+      mediaGate([worker, { ...chrome, cgroup: "0::/escaped" }, encoder], domain),
+    ).toThrow("out-of-domain");
+  });
+});
