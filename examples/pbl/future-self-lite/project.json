        }
      ],
      "documents": ["docs/brief.md"]
    },
    {
      "stage": "message:1",
      "role": "discussion",
      "entrypoint": "skills/SKILL.md",
      "sections": [
        {
          "name": "A-decisions.md",
          "path": "skills/A-decisions.md"
        }
      ],
      "documents": ["docs/brief.md"]
    },
    {
      "stage": "message:2",
      "role": "planner",
      "entrypoint": "skills/SKILL.md",
      "sections": [
        {
          "name": "A-plan.md",
          "path": "skills/A-plan.md"
        }
      ],
      "documents": ["docs/brief.md"]
    },
    {
      "stage": "message:3",
      "role": "coder",
      "entrypoint": "skills/SKILL.md",
      "sections": [
        {
          "name": "A-implement.md",
          "path": "skills/A-implement.md"
        }
      ],
      "documents": ["docs/brief.md"]
    },
    {
      "stage": "message:6",
      "role": "mentor",
      "entrypoint": "skills/SKILL.md",
      "sections": [
        {
          "name": "A-recap.md",
          "path": "skills/A-recap.md"
        }
      ],
      "documents": ["docs/brief.md"]
    }
  ]
