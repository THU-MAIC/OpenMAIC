{
  "formatVersion": 1,
  "id": "future-self-lite",
  "version": "1.0.0",
  "definition": {
    "id": "future-self-lite",
    "title": "给未来的自己留一句话",
    "language": "Python",
    "providerRef": "host",
    "paths": {
      "requirements": "docs",
      "pedagogy": "skills",
      "skeleton": "skeleton",
      "tests": "tests",
      "rubric": "rubric"
    },
    "protectedPaths": [],
    "testing": {
      "runCmd": "python3",
      "reportPath": "report",
      "reportFormat": "exit-code"
    },
    "agents": {
      "commonRules": "用中文引导学习者。依据当前阶段绑定的材料和实际工具结果解释任务，等待平台推进阶段。",
      "mentor": {
        "systemPrompt": "帮助学习者理解给未来的自己留言这个任务。",
        "tools": [],
        "skillPaths": []
      },
      "discussion": {
        "systemPrompt": "围绕当前留言需求回答学习者的问题。",
        "tools": [],
        "skillPaths": []
      },
      "planner": {
        "systemPrompt": "帮助学习者描述实现留言函数的步骤。",
        "tools": [],
        "skillPaths": []
      },
      "coder": {
        "systemPrompt": "帮助学习者实现并解释 src/main.py 中的 future_message 函数。",
        "tools": [],
        "skillPaths": []
      }
    },
    "intro": {
      "say": "我们要写一个返回给未来自己的留言的 Python 函数。先读需求，再实现并检查结果。"
    },
    "visibility": {
      "roleViews": {
        "discussion": [],
        "planner": [],
        "coder": ["docs/brief.md"]
      },
      "answerKeys": [],
      "testSupport": []
    },
    "decisions": [],
    "milestones": [
      {
        "id": "message",
        "type": "task",
        "title": "完成留言函数",
        "contract": "future_message(name) 返回字符串：给未来的{name}：继续保持好奇心。保留传入的名字，不打印结果。",
        "tests": ["tests/check.py"],
        "stages": [
          {
            "kind": "mentor_say",
            "agent": "discussion",
            "say": "Explain function inputs and return values, after the project welcome.",
            "studentActions": ["chat", "next"]
          },
          {
            "kind": "dialogue",
            "agent": "discussion",
            "reads": ["contract"],
            "collects": "decisions",
            "studentActions": ["chat", "decide", "next"]
          },
          {
            "kind": "produce",
            "agent": "planner",
            "reads": ["contract"],
            "writes": "plan",
            "skill": "planner-plan-review",
            "reviewRequired": true,
            "studentActions": ["chat", "edit", "next"]
          },
          {
            "kind": "produce",
            "agent": "coder",
            "skill": "future-self-lite",
            "reads": ["contract", "plan"],
            "writes": "code",
            "reviewRequired": true,
            "compileBeforeReview": true,
            "studentActions": ["chat", "edit", "next"]
          },
          {
            "kind": "check",
            "checker": "tests",
            "evaluation": {
              "capabilityIds": ["exit-code"],
              "evaluatorRefs": ["tests/check.py"]
            }
          },
          {
            "kind": "check",
            "checker": "quiz"
          },
          {
            "kind": "mentor_say",
            "agent": "mentor",
            "say": "Reflect on the recorded plan, implementation, tests and learner feedback.",
            "skill": "recap",
            "reads": ["plan", "code"],
            "studentActions": ["chat", "next"]
          }
        ],
        "quiz": [
          {
            "q": "What does return do?",
            "options": ["Passes a value to the caller", "Prints a value automatically"],
            "answer": 0,
            "explain": "return passes a value to the caller."
          }
        ]
      }
    ]
  },
  "runtime": {
    "profile": "python3",
    "sourceRoots": ["src"],
    "buildSources": ["src/main.py"],
    "evaluations": {
      "message": "tests/message.json"
    }
  },
  "teaching": [
    {
      "stage": "message:0",
      "role": "discussion",
      "entrypoint": "skills/SKILL.md",
      "sections": [
        {
          "name": "A-intro.md",
