  .cover-orb-b { width:50%;height:68%;right:-15%;bottom:-28%;background:#6d4bc3; }
  .cover-panel { position:relative;z-index:1;width:min(88%,1560px);max-height:100%;overflow:hidden;border:2px solid rgba(255,255,255,.13);border-radius:42px;background:rgba(11,18,33,.82);box-shadow:0 45px 120px rgba(0,0,0,.42);backdrop-filter:blur(24px); }
  .cover-quiz-panel { width:min(76%,1230px);padding:6.5% 8%;text-align:center; }
  .cover-pbl-panel { padding:4.5% 5.5%; }
  .cover-eyebrow { display:inline-flex;align-items:center;gap:12px;margin-bottom:27px;color:#8fdcf5;font-size:20px;font-weight:750;letter-spacing:.12em;text-transform:uppercase; }
  .cover-eyebrow-icon { display:inline-grid;place-items:center;width:39px;height:39px;border-radius:999px;background:rgba(86,197,234,.14);border:2px solid rgba(111,220,255,.26); }
  .cover-title { display:-webkit-box;max-width:100%;margin:0;overflow:hidden;-webkit-box-orient:vertical;-webkit-line-clamp:2;font-size:78px;line-height:1.08;letter-spacing:-.035em; }
  .cover-description { display:-webkit-box;max-width:92%;margin:24px 0 0;overflow:hidden;-webkit-box-orient:vertical;-webkit-line-clamp:3;color:#c4cedd;font-size:29px;line-height:1.45; }
  .cover-stats { display:flex;gap:18px; }
  .cover-quiz-stats { justify-content:center;margin-top:51px; }
  .cover-stat { display:flex;min-width:198px;align-items:baseline;justify-content:center;gap:12px;padding:20px 27px;border:2px solid rgba(255,255,255,.11);border-radius:24px;background:rgba(255,255,255,.055); }
  .cover-stat strong { color:#fff;font-size:42px;line-height:1; }
  .cover-stat span { color:#aebbd0;font-size:20px;text-transform:uppercase;letter-spacing:.07em; }
  .cover-gains { margin-top:33px; }
  .cover-section-label { margin-bottom:15px;color:#98a8be;font-size:17px;font-weight:750;letter-spacing:.11em;text-transform:uppercase; }
  .cover-gains ul { display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px;margin:0;padding:0;list-style:none; }
  .cover-gains li { display:flex;min-width:0;align-items:flex-start;gap:14px;padding:15px 18px;border:2px solid rgba(255,255,255,.08);border-radius:20px;background:rgba(255,255,255,.035); }
  .cover-check { flex:0 0 auto;color:#6ee7b7;font-weight:800; }
