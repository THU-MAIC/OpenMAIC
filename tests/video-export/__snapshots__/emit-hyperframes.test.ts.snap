  .cover-person-copy { display:flex;min-width:0;flex-direction:column; }
  .cover-person-copy span { color:#91a2ba;font-size:14px;font-weight:700;line-height:1.1;letter-spacing:.09em;text-transform:uppercase; }
  .cover-person-copy strong { overflow:hidden;color:#f5f7fb;font-size:21px;line-height:1.1;text-overflow:ellipsis;white-space:nowrap; }
  .cover-person-copy small { display:-webkit-box;overflow:hidden;-webkit-box-orient:vertical;-webkit-line-clamp:2;color:#aebbd0;font-size:15px;line-height:1.25; }
  .cover-cta { display:grid;gap:6px;margin-top:27px;text-align:center; }
  .cover-cta-line { min-width:0;color:#aebbd0;font-size:18px;line-height:1.35;overflow-wrap:anywhere;white-space:normal; }
  .cover-cta-line bdi { overflow-wrap:anywhere;word-break:break-word; }
  .cover-cta-line:last-child { color:#f8fafc;font-weight:700; }
