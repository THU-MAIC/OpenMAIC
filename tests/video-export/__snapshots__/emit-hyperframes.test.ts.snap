tl.fromTo('#fx-0-2-ring',{scale:1,opacity:0.6},{scale:2.8,opacity:0,duration:1.5,ease:EASE_OUT,repeat:1,repeatDelay:0.3},2);
tl.to('#fx-0-2',{autoAlpha:0,x:-1056,y:-591.6,duration:0.25,ease:EASE_IN},4.75);
tl.set('#fx-0-2',{autoAlpha:0},5);
tl.set('#fx-0-2-ring',{opacity:0},5);
tl.set({}, {}, 7);
window.__timelines = window.__timelines || {};
window.__timelines["openmaic"] = tl;
</script>
